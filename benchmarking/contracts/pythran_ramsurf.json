  "source_excerpt": "from zinnia import *\n# Zinnia benchmark contract draft: generated for review.\n# Keep kernel body faithful; refine TODO contracts before final benchmark runs.\n# Categories: complex, data-dependent-loop, denominator-obligation, domain-obligation, in-place-mutation, loop-bounded\n# Expected outcome: diagnostic/fail-closed candidate\n# Precondition: Add an explicit iteration cap or classify as fail-closed until a bound is available.\n# Precondition: Add nonzero or positive denominator facts at exact division/modulo sites when expressible.\n# Precondition: Add operation-specific domains: sqrt arg >= 0, log arg > 0, acos arg in [-1, 1].\n# Precondition: Loop trip counts must be finite and tied to scalar bounds or array dimensions.\n# Precondition: Use writable fixed/bounded array shapes and record an aliasing policy for mutated inputs.\n# Diagnostic: Complex kernels require Complex dtype support or a fail-closed classification.\n# Diagnostic: while loops require a public/padded maximum iteration count.\nimport cmath\n\n@zk_chip\ndef guerre(a: Complex[Array, 'N<=1024'], n: Integer, z: Float, err: Float, nter: Float):\n    az = [complex(0, 0) for i in range(50)]\n    azz = [complex(0, 0) for i in range(50)]\n    ci = complex(0.0, 1.0)\n    eps = 1e-20\n    for i in range(1, n + 1):\n        az[i - 1] = float(i) * a[i]\n    for i in range(1, n):\n        azz[i - 1] = float(i) * az[i]\n    dz = err + 1\n    itera = 0\n    jter = 0\n    while abs(dz) > err and itera < nter:\n        p = a[n - 1] + a[n] * z\n        for i in range(n - 1, 0, -1):\n            p = a[i - 1] + z * p\n        if abs(p) < eps:\n            return z\n        pz = az[n - 2] + az[n - 1] * z\n        for i in range(n - 2, 0, -1):\n            pz = az[i - 1] + z * pz\n        pzz = azz[n - 3] + azz[n - 2] * z\n        for i in range(n - 3, 0, -1):\n            pzz = azz[i - 1] + z * pzz\n        f = pz / p\n        g = f ** 2 - pzz / p\n        h = n * g\n        amp1 = abs(f + h)\n        amp2 = abs(f - h)\n        if amp1 > amp2:\n            dz = float(-n) / (f + h)\n        else:\n            dz = float(-n) / (f - h)\n        itera = itera + 1\n        jter = jter + 1\n        if jter == 10:\n            jter = 1\n            dz = dz * ci\n        z = z + dz\n        if jter == 100:\n            raise RuntimeError('Laguerre method not converging')\n    return z\n\n@zk_chip\ndef fndrt(a: Complex[Array, 'N<=1024'], n: Integer):\n    z = [complex(0, 0) for k in range(n)]\n    if n == 1:\n        z[0] = -a[0] / a[1]\n        return z\n    if n > 2:\n        for k in range(n, 2, -1):\n            root = complex(0.0, 0)\n            err = 1e-12\n            root = guerre(a, k, root, err, 1000)\n            err = 0.0\n            root = guerre(a, k, root, err, 5)\n            z[k - 1] = root\n            for i in range(k, 0, -1):\n                a[i - 1] = a[i - 1] + root * a[i]\n            for i in range(1, k + 1):\n                a[i - 1] = a[i]\n    z[1] = 0.5 * (-a[1] + cmath.sqrt(a[1] * a[1] - 4.0 * a[0] * a[2])) / a[2]\n    z[0] = 0.5 * (-a[1] - cmath.sqrt(a[1] * a[1] - 4.0 * a[0] * a[2])) / a[2]\n    return z\n",
