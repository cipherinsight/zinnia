# Template for Scarb.toml: `zkvm_common/sync_cases.py` appends one executable
# target per fixed `main.cairo` or shaped `cairo/<function>.cairo`.
[package]
name = "ds1000_cairo"
version = "0.1.0"
edition = "2024_07"

[dependencies]
cairo_execute = "2.20.0"

[dev-dependencies]
cairo_test = "2.20.0"

[cairo]
enable-gas = false

# @EXECUTABLES@
