  "source_excerpt": "from zinnia import *\n\n@zk_circuit\n@requires(lambda n: 0 <= n <= 1024)\ndef pselect(n: Integer):\n    l = list()\n    for k in (n, not n):\n        if k:\n            a = sel0\n        else:\n            a = sel1\n        a(l)\n    return l\n\n@zk_chip\ndef sel0(n: List[Float]):\n    n.append(1)\n\n@zk_chip\ndef sel1(n: List[Float]):\n    n.append(2.0)",
