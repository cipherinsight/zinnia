"""Loading, classifying and compiling `kernel.py` files, and the scope rule."""

from __future__ import annotations

import ast
import importlib.util
import sys
from pathlib import Path
from types import ModuleType
from typing import Any

#: The scope rule (author's decision, applied to every dataset): a kernel that
#: imports any module other than `numpy` (and its submodules) and `math` is out
#: of scope. `zinnia` is the language's own import and is always allowed.
ALLOWED_TOP_LEVEL_MODULES = frozenset({"numpy", "math", "zinnia"})


def imported_modules(path: Path) -> list[str]:
    """Top-level module names of every import statement in the file."""
    tree = ast.parse(path.read_text(encoding="utf-8", errors="replace"))
    names: list[str] = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names.extend(alias.name.split(".")[0] for alias in node.names)
        elif isinstance(node, ast.ImportFrom):
            if node.level:  # relative import: a sibling module, never in scope
                names.append("." * node.level + (node.module or ""))
            elif node.module:
                names.append(node.module.split(".")[0])
    return names


def out_of_scope_imports(path: Path) -> list[str]:
    """The imports that put this kernel out of scope (empty = in scope)."""
    return sorted({n for n in imported_modules(path) if n not in ALLOWED_TOP_LEVEL_MODULES})


def function_roles(path: Path) -> dict[str, str]:
    """`circuit`, `chip` or `plain` for every top-level function of the file."""
    tree = ast.parse(path.read_text(encoding="utf-8", errors="ignore"))
    roles: dict[str, str] = {}
    for node in tree.body:
        if not isinstance(node, ast.FunctionDef):
            continue
        decorators = {ast.unparse(dec) for dec in node.decorator_list}
        if any(d == "zk_circuit" or d.startswith("zk_circuit(") for d in decorators):
            roles[node.name] = "circuit"
        elif any(d == "zk_chip" or d.startswith("zk_chip(") for d in decorators):
            roles[node.name] = "chip"
        else:
            roles[node.name] = "plain"
    return roles


def load_kernel_module(path: Path) -> ModuleType:
    """Import a kernel file under a module name derived from its folder.

    The module is registered in `sys.modules` so that chips and helpers
    defined in the same file resolve during compilation.
    """
    module_name = "zinnia_benchmark_" + path.parent.name
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"could not load module spec for {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    spec.loader.exec_module(module)
    return module


def compile_kernel(path: Path, function: str, backend: str = "halo2") -> Any:
    """Compile one `@zk_circuit` function for `backend` (`ZinniaConfig.backend`:
    `halo2` or `noir`); returns a `ZKCompiledProgram`.

    The backend is the compile target. Where Zinnia has several equivalent
    lowerings (sorts: a sorting network or pinned prover hints) it picks the one
    cheaper on that backend; the program proves on every backend either way.
    """
    from zinnia import ZKCircuit
    from zinnia.config.zinnia_config import ZinniaConfig

    module = load_kernel_module(path)
    circuit = ZKCircuit.from_method(getattr(module, function), config=ZinniaConfig(backend=backend))
    return circuit.compile()
def _mock_publics(proof) -> tuple[list[int], bool]:
    """Mock public values (signed integers, Q32 for floats) in exposure order.

    The mock names each public after its `ExposePublic` statement id, so sorting
    by that id restores the exposure order a real backend uses.
    """
    entries = []
    for entry in proof.public_values:
        name, _, value = entry.partition("=")
        entries.append((int(name.rsplit("_", 1)[1]), int(value)))
    entries.sort()
    return [v for _, v in entries], proof.proof_bytes_hex == "mock_satisfied"


def check_program(request: dict) -> dict:
    """Compile, mock-run and compare one program (runs in the child)."""
    from benchmarking.harness.adapters.base import StepFailure
    from benchmarking.harness.adapters.zinnia_common import describe_compiled, zinnia_publics
    from benchmarking.harness.fixtures import PROVE_INPUT, SETUP_INPUT, load_fixture
    from benchmarking.harness.kernels import compile_kernel
    from benchmarking.harness.outputs import UnlistedOutput, check_outputs, reference_outputs
    from benchmarking.harness.reference import run_kernel_with_arguments

    kernel, function = Path(request["kernel"]), request["function"]
    started = time.perf_counter()
    try:
        compiled = compile_kernel(kernel, function)
    except BaseException as exc:  # noqa: BLE001 - PyO3 panics derive from BaseException
        if isinstance(exc, (KeyboardInterrupt, SystemExit)):
            raise
        return {"stage": "compile", "error": f"{type(exc).__name__}: {exc}"[:2000]}
    result = {"stage": "compiled", "compile_s": time.perf_counter() - started}
    if not request.get("fixture"):
        return {**result, "unchecked": "no fixture"}
    fixture = load_fixture(Path(request["fixture"]))
    input_name = PROVE_INPUT if PROVE_INPUT in fixture.inputs else SETUP_INPUT
    args = fixture.arguments(input_name)
    try:
        proof = compiled.prove(*args, backend="mock")
    except BaseException as exc:  # noqa: BLE001
        if isinstance(exc, (KeyboardInterrupt, SystemExit)):
            raise
        return {**result, "stage": "mock", "mock_error": f"{type(exc).__name__}: {exc}"[:2000]}
    values, satisfied = _mock_publics(proof)
    if not satisfied:
        return {**result, "stage": "mock", "mock_error": "constraints unsatisfied on the "
                                                         "honest input"}
    info = describe_compiled(compiled)
    try:
        returned, arguments_after = run_kernel_with_arguments(kernel, function, args)
        expected, shapes = reference_outputs(returned, arguments_after, args,
                                             info["output_layout"])
    except UnlistedOutput as exc:
        return {**result, "stage": "checked", "input": input_name,
                "output_check": {"status": "mismatch", "detail": str(exc)}}
    except Exception as exc:  # noqa: BLE001
        return {**result, "unchecked": f"no reference: {type(exc).__name__}: {exc}"[:500]}
    try:
        publics = zinnia_publics(values, info)
    except StepFailure as failure:
        return {**result, "stage": "decode", "decode_error": failure.detail}
    check = check_outputs(expected, publics, Tolerance(**request["tolerance"]),
                          expected_shapes=shapes)
    return {**result, "stage": "checked", "input": input_name, "output_check": check.to_json()}


def _child_main(request_path: Path, response_path: Path) -> int:
    request = json.loads(request_path.read_text())
    try:
        response = check_program(request)
    except Exception as exc:  # noqa: BLE001
        response = {"stage": "harness", "error": f"{type(exc).__name__}: {exc}",
                    "traceback": traceback.format_exc(limit=6)}
    response_path.write_text(json.dumps(response))
    return 0


# ---------------------------------------------------------------------------
# Parent side
# ---------------------------------------------------------------------------


def _run_isolated(program: AcceptanceProgram, config: AcceptanceConfig, work: Path,
                  smt_budget_ms: int | None) -> dict:
    tag = program.program.replace("/", "_") + (f"-smt{smt_budget_ms}" if smt_budget_ms else "")
    request_path, response_path = work / f"{tag}.request.json", work / f"{tag}.response.json"


# ------------------------------------------------------------------ Zinnia side


def zinnia_one(case: str, other_lookup_bits: int | None = None) -> dict:
    """Compile one kernel and measure it (runs inside the child process).

    When `other_lookup_bits` (the baseline's width) is wider than the width
    Zinnia chose, the record also carries `at_common`: the cells at that width."""
    from benchmarking.harness.kernels import compile_kernel
    from zinnia._zinnia_core import halo2_base_cell_stats

    started = time.perf_counter()
    compiled = compile_kernel(paths.DS1000_PERF / case / "kernel.py", "kernel")
    compiled_s = time.perf_counter() - started
    census = collections.Counter()
    for stmt in compiled.get_ir_stmts():
        name = str(stmt["ir_instance"]["__class__"]).removesuffix("IR")
        if name in CENSUS_OPS:
            census[name] += 1
    stats = json.loads(halo2_base_cell_stats(compiled._compiled_ir))
    if other_lookup_bits is not None and other_lookup_bits > stats["lookup_bits"]:
        params = {"k": stats["k"], "precision_bits": stats["precision_bits"],
                  "lookup_bits": other_lookup_bits}
        wider = json.loads(halo2_base_cell_stats(compiled._compiled_ir, json.dumps(params)))
        stats["at_common"] = {key: wider[key] for key in ("lookup_bits", "advice", "lookup")}
    stats["ops"] = dict(sorted(census.items()))
    stats["ir_stmts"] = len(compiled.get_ir_stmts())
    stats["compile_s"] = round(compiled_s, 3)
    stats["measure_s"] = round(time.perf_counter() - started - compiled_s, 3)
    return stats

