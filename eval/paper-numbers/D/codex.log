pub struct ScatterByHits;

impl Construction for ScatterByHits {
    fn name(&self) -> &'static str {
        "gather: permutation scatter by hits"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        if group.kind != OpKind::PermutationScatter {
            return Vec::new();
        }
        let n = group.shared.len() / 2;
        let offset = scatter_offset(cx, group);
        let mut post: Vec<Requirement> = lanes(group).collect();
        if offset.is_some() {
            post.push(Requirement::Shared { group: group.id, name: ENCODING });
        }
        let permutation = crate::lower::permutation::permutation_fact(&group.shared[..n]);
        // The hits are the permutation check's equality tests when the
        // program checks `p` (deduplicated); an argsort, a permutation by
        // definition, has no check, and the scatter pays for them.
        let checked = cx.sharing_groups(group).any(|g| g.kind == OpKind::IsPermutation && g.shared[..] == group.shared[..n]);
        let tests = if checked { 0 } else { (n * n) as u64 * cost::units(cx.target).eq_const };
        vec![Candidate {
            pre: vec![Requirement::Fact(permutation)],
            post,
            cost: cost::permutation_scatter(n as u64, cx.target) + tests,
            emitter: Box::new(ScatterEmitter { operands: group.shared.clone(), offset, hits: Vec::new(), cells: Vec::new() }),
        }]
    }
}

/// `c[p] = v` for a permutation `p` as `n` writes into a fresh array of `n`
/// cells, its cells read at constant addresses: an array version chain the
/// memory family lowers in the next round (a RAM trace on halo2-base, the
/// native RAM on Noir, or an overlay of selects), linear in `n` where the
/// hits are quadratic.
///
/// * Preconditions: `Permutation(p, 0..n)` (every write lands in the array,
///   and every cell is written exactly once, so its value does not depend
///   on the order of the writes or the initial zeros); on halo2-base the
///   RAM trace (`memory::versions::RAM`, paid once), which the next round's
///   lowering most likely uses (its estimate here).
/// * Postconditions: every cell.
/// * Soundness: the writes and reads are the array semantics the memory
///   constructions implement; with `p` a permutation, cell `j` holds the
///   `v_k` with `p_k = j` (NumPy's `c[p] = v`).
/// * Cost: the memory family's estimate of the chain (`memory::versions`):
///   halo2-base 8 cells per initial row and per access (`n` writes, `n`
///   reads); Noir's native RAM `3n + 3.5n` gates per access.
pub struct ScatterByWrites;

impl Construction for ScatterByWrites {
    fn name(&self) -> &'static str {
        "gather: permutation scatter by writes"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        if group.kind != OpKind::PermutationScatter {
            return Vec::new();
        }
        let n = group.shared.len() / 2;
        let permutation = crate::lower::permutation::permutation_fact(&group.shared[..n]);
        let (pre, cost) = match cx.target {
            crate::lower::Target::Halo2Base => {
                (vec![Requirement::Fact(permutation), crate::lower::memory::versions::RAM], 8 * 3 * n as u64)
            }
            crate::lower::Target::Noir => {
                let n = n as u64;
                (vec![Requirement::Fact(permutation)], 3 * n + (7 * n).div_ceil(2) * 2 * n)
            }
        };
        vec![Candidate {
            pre,
            post: lanes(group).collect(),
            cost,
            emitter: Box::new(WritesEmitter { operands: group.shared.clone(), version: None }),
        }]
    }
}

//! Window gather: `x[s0:e0, s1:e1, ...]` with runtime bounds as a shift of
//! the whole array by a shared one-hot per axis.
//!
//! The element-wise lowering read every output cell on its own: per output
//! position a clamp, a box test, an address and a gather by indicators of
//! the address, and a padding select (about 75 halo2-base cells per output
//! of a 10x10 crop). Here the index map of each axis is affine with one
//! runtime offset, `u -> start + u`, so one one-hot of `start` serves every
//! output position of that axis:
//!
//! ```text
//! y[.., u, ..] = sum_d sel[u][d] * x[.., u + d, ..]     (terms u + d >= n dropped)
//! sel[u][d]    = [start == d] * [d + u < stop]
//! ```
//!
//! applied to one axis at a time (rows, then columns, ...).
//!
//! **Preconditions.** Every axis has step 1 and `0 <= start <= n` (Python's
//! slice normalization established it before the placeholder was emitted);
//! `stop` is any integer. A start or stop encoding, when given, is exact
//! (`scan.rs`). `padding_zero` only when every source cell at a position
//! `>= stop` of the axis is 0 (`constructions::padding_is_zero`).
//!
//! **Postconditions.** `y` holds the window `x[start:stop]` at the top-left
//! of a buffer of `x`'s shape and 0 everywhere else: the cells the
//! element-wise lowering produced, so the recorded extents and the output
//! layout are unchanged.
//!
//! **Soundness.** No prover hint: every selector is a product of exact
//! indicator bits. Since `start` is in `[0, n]`, at most one `[start == d]`
//! is 1, so each sum is either `x[.., start + u, ..]` (when `start + u <
//! stop` and `start + u < n`) or 0. Without the mask (`padding_zero`), a
//! position past `stop` reads a source cell at a position `>= stop`, which is
//! 0 by the precondition; the shifts along the other axes only combine cells
//! of one position of this axis, so that holds for every intermediate array.
//!
//! **Cost** (`cost::window_shift`) for an `R x C` window: `R(R+1)/2 C +
//! C(C+1)/2 R` multiply-adds (3 halo2-base cells, 1 Noir gate each), plus per
//! axis the selectors: equality tests unless the start's one-hot is given,
//! and the mask (one product per selector, plus a comparison per position
//! without a thermometer of `stop`; nothing when the padding is 0).

use crate::builder::IRBuilder;
use crate::helpers::shape_arith::{decode_coords, row_major_strides};
use crate::types::{NumberType, ScalarValue, Value};

use super::encoding::{onehot_over, IndexEncoding};

/// One windowed axis: `start:stop` with step 1, `start` in `[0, n]`.
pub struct AxisWindow {
    pub axis: usize,
    pub start: Value,
    pub stop: Value,
    /// The encoding of `start`, when a scan produced it.
    pub start_encoding: Option<IndexEncoding>,
    /// The encoding of `stop`, when it has a thermometer.
    pub stop_encoding: Option<IndexEncoding>,
    /// Every source cell past `stop` on this axis is 0: no mask.
    pub padding_zero: bool,
}

/// The window of `cells` (row-major over `shape`, integer or float) given by
/// `windows`, at the top-left of a buffer of `shape` padded with 0.
pub fn window_shift(
    b: &mut IRBuilder,
    cells: Vec<Value>,
    shape: &[usize],
    windows: &[AxisWindow],
    dtype: NumberType,
) -> Vec<Value> {
    let strides = row_major_strides(shape);
    let mut cells = cells;
    for window in windows {
        let selectors = axis_selectors(b, shape[window.axis], window);
        cells = shift_axis(b, &cells, shape, &strides, window.axis, &selectors, dtype);
    }
    cells
}

/// `sel[u][d] = [start == d] * [d + u < stop]` for `u + d < n` (the second
/// factor dropped when it is always 1 on the selected terms or the padding
/// is 0 anyway).
fn axis_selectors(b: &mut IRBuilder, n: usize, window: &AxisWindow) -> Vec<Vec<Value>> {
    let at = onehot_over(b, &window.start, window.start_encoding.as_ref(), 0, n);
    let mask = StopMask::new(b, n, window);
    (0..n)
        .map(|u| (0..n - u).map(|d| mask.select(b, &at[d], d, u)).collect())
        .collect()
}

/// How a selector learns `[d + u < stop]` (for the `d` whose bit is set).
enum StopMask {
    /// `stop >= n` (every kept term is inside the window), or the cells past
    /// `stop` are 0.
    Unneeded,
    /// A thermometer of `stop`: the bit is free.
    Thermometer(IndexEncoding),
    /// One comparison per output position, `[start + u < stop]`.
    Compared(Vec<Value>),
}

impl StopMask {
    fn new(b: &mut IRBuilder, n: usize, window: &AxisWindow) -> StopMask {
        if window.padding_zero || window.stop.int_val().is_some_and(|s| s >= n as i64) {
            return StopMask::Unneeded;
        }
        if let Some(enc) = window.stop_encoding.clone().filter(|e| e.below.is_some()) {
            return StopMask::Thermometer(enc);
        }
        let masks = (0..n)
            .map(|u| {
                let u_v = b.ir_constant_int(u as i64);
                let position = b.ir_add_i(&window.start, &u_v);
                b.ir_less_than_i_bounded(&position, &window.stop)
            })
            .collect();
        StopMask::Compared(masks)
    }

    /// `at_d * [d + u < stop]`, given `at_d = [start == d]`.
    fn select(&self, b: &mut IRBuilder, at_d: &Value, d: usize, u: usize) -> Value {
        match self {
            StopMask::Unneeded => at_d.clone(),
            StopMask::Compared(masks) => b.ir_mul_i(at_d, &masks[u]),
            StopMask::Thermometer(enc) => {
                // [t < stop] = 1 - [stop < t + 1].
                let stop_le_t = enc.less_than(b, (d + u) as i64 + 1).expect("the encoding has a thermometer");
                stop_le_t.not().and(b, at_d)
            }
        }
    }
}

/// One shift along `axis`: `y[.., u, ..] = sum_d sel[u][d] * x[.., u + d, ..]`.
fn shift_axis(
    b: &mut IRBuilder,
    cells: &[Value],
    shape: &[usize],
    strides: &[usize],
    axis: usize,
    selectors: &[Vec<Value>],
    dtype: NumberType,
) -> Vec<Value> {
    (0..cells.len())
        .map(|flat| {
            let u = decode_coords(flat, shape, strides)[axis];
            let terms: Vec<Value> = selectors[u]
                .iter()
                .enumerate()
                .map(|(d, sel)| scale_by_bit(b, sel, &cells[flat + d * strides[axis]], dtype))
                .collect();
            sum_typed(b, terms, dtype)
        })
        .collect()
}
        "sort: network"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        plans(group, cx, cost::network_plans)
    }
}

impl Construction for RankSelection {
    fn name(&self) -> &'static str {
        "sort: rank selectors"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        plans(group, cx, |demand, costs| vec![cost::rank_selector_plan(demand, costs)])
    }
}

impl Construction for PermutationCheck {
    fn name(&self) -> &'static str {
        "sort: permutation check"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        plans(group, cx, |demand, costs| cost::full_permutation(demand, costs).into_iter().collect())
    }
}

impl Construction for PinnedSelection {
    fn name(&self) -> &'static str {
        "sort: pinned selection"
    }

    fn candidates(&self, group: &Group, cx: &Context) -> Vec<Candidate> {
        plans(group, cx, cost::selection_plans)
    }
}

/// The candidates of the plans `offer` prices for `group`'s live lanes, each
/// producing every lane.
fn plans(group: &Group, cx: &Context, offer: impl Fn(&Demand, &UnitCosts) -> Vec<(Plan, u64)>) -> Vec<Candidate> {
    if group.kind != OpKind::Sort {
        return Vec::new();
    }
    let demand = demand(group, cx);
    let range = narrow_range(group, cx);
    // The count lanes, one comparison per element each in every plan
    // (`counts::count_query`), priced so that a plan answering them by
    // positions in its sorted values (`SortCountsByPosition`) compares.
    let float = group.shared.iter().any(|&s| search::is_float_stmt(cx, s));
    let counts = count_lanes(group) * group.shared.len() as u64 * search::count_cost_per_entry(cx.target, float);
    offer(&demand, &cost::unit_costs(cx.target))
        .into_iter()
        .map(|(plan, cost)| {
            let mut candidate = plan_candidate(group, demand.clone(), plan, cost + counts, range.map(|(lo, hi, _)| (lo, hi)));
            candidate.pre.extend(range.map(|(_, _, fact)| Requirement::Fact(fact)));
            candidate
        })
        .collect()
}

/// The number of count lanes of a sort (`COUNT_AT_MOST`, `COUNT_BELOW`).
fn count_lanes(group: &Group) -> u64 {
    group.lanes.iter().filter(|lane| lane.output == COUNT_AT_MOST || lane.output == COUNT_BELOW).count() as u64
}

