"""`fixture.json`: the inputs of one case (schema in `eval-redo/BRIEF.md`).

```json
{"case": "ds1000_case0300", "function": "kernel",
 "parameters": [{"name": "a", "kind": "array", "dtype": "float", "shape": [20]},
                {"name": "p", "kind": "scalar", "dtype": "int"}],
 "inputs": {"A": {"a": [...], "p": 25}, "B": {"a": [...], "p": 37}},
 "notes": "..."}
```

Input `A` is used for setup (key generation), input `B` for every timed proof
and the output check. Every input is private and every output public.
"""

from __future__ import annotations

import hashlib
import json
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Mapping

import numpy as np

SETUP_INPUT = "A"
PROVE_INPUT = "B"

_NUMPY_DTYPES = {"float": np.float64, "int": np.int64, "bool": np.bool_, "complex": np.complex128}
_SCALAR_TYPES = {"float": float, "int": int, "bool": bool, "complex": complex}


class FixtureError(ValueError):
    """A fixture that does not satisfy the schema."""


@dataclass(frozen=True)
class Parameter:
    name: str
    kind: str  # "array" | "scalar"
    dtype: str  # "float" | "int" | "bool" | "complex" (values as [real, imag] pairs)
    shape: tuple[int, ...]


@dataclass(frozen=True)
class Fixture:
    case: str
    function: str
    parameters: tuple[Parameter, ...]
    inputs: Mapping[str, Mapping[str, Any]]
    path: Path
    sha256: str

    def values(self, input_name: str) -> dict[str, Any]:
        """The raw JSON values of one input, by parameter name."""
        try:
            return dict(self.inputs[input_name])
        except KeyError:
            raise FixtureError(f"{self.path}: no input {input_name!r}") from None

    def arguments(self, input_name: str) -> list[Any]:
        """The kernel's positional arguments for one input, in signature order.

        Arrays become NumPy arrays of the declared dtype and shape; scalars
        become Python `float`, `int` or `bool`.
        """
        values = self.values(input_name)
        return [_argument(param, values[param.name]) for param in self.parameters]


def _argument(param: Parameter, value: Any) -> Any:
    if param.dtype == "complex":
        value = _complex_values(value)
    if param.kind == "scalar":
        return _SCALAR_TYPES[param.dtype](value)
    array = np.array(value, dtype=_NUMPY_DTYPES[param.dtype])
    if array.shape != param.shape:
        raise FixtureError(f"parameter {param.name!r}: value has shape {array.shape}, "
                           f"declared {param.shape}")
    return array


def _complex_values(value: Any) -> Any:
    """A complex fixture value: each number is the pair `[real, imag]` (JSON
    has no complex numbers), nested like the array it belongs to."""
    if isinstance(value, list) and len(value) == 2 \
            and all(isinstance(part, (int, float)) for part in value):
        return complex(value[0], value[1])
    if isinstance(value, list):
        return [_complex_values(item) for item in value]
    raise FixtureError(f"complex value {value!r} is not a [real, imag] pair")


def _parameter(raw: Mapping[str, Any]) -> Parameter:
    kind = raw.get("kind")
    dtype = raw.get("dtype")
    if kind not in ("array", "scalar"):
        raise FixtureError(f"parameter {raw.get('name')!r}: kind must be array or scalar")
    if dtype not in _NUMPY_DTYPES:
        raise FixtureError(f"parameter {raw.get('name')!r}: dtype must be float, int, bool "
                           "or complex")
    shape = tuple(int(d) for d in raw.get("shape", ())) if kind == "array" else ()
    return Parameter(name=str(raw["name"]), kind=kind, dtype=dtype, shape=shape)


def load_fixture(path: Path) -> Fixture:
    """Load and validate one fixture file."""
    data = path.read_bytes()
    raw = json.loads(data)
    try:
        parameters = tuple(_parameter(p) for p in raw["parameters"])
        inputs = raw["inputs"]
        fixture = Fixture(case=str(raw["case"]), function=str(raw.get("function", "kernel")),
                          parameters=parameters, inputs=inputs, path=path,
                          sha256=hashlib.sha256(data).hexdigest())
    except KeyError as exc:
        raise FixtureError(f"{path}: missing field {exc}") from None
    _validate(fixture)
    return fixture


def _validate(fixture: Fixture) -> None:
    for name in (SETUP_INPUT, PROVE_INPUT):
        values = fixture.values(name)
        missing = [p.name for p in fixture.parameters if p.name not in values]
        if missing:
            raise FixtureError(f"{fixture.path}: input {name} lacks {missing}")
        fixture.arguments(name)  # checks shapes and dtypes
    # A kernel without parameters has one possible input, used for both.
    if fixture.parameters and fixture.values(SETUP_INPUT) == fixture.values(PROVE_INPUT):
        raise FixtureError(f"{fixture.path}: inputs A and B must differ")
"""The NumPy reference: a kernel's body run as plain NumPy.

The `@zk_circuit` decorator (and `@zk_chip`, `@zk_external`) becomes the
identity, Zinnia's annotation names stay importable, and the function is called
on copies of the inputs (kernels may mutate their arguments). No per-case
overrides: a kernel whose body is not valid NumPy has no reference, and the
harness reports that.
"""

from __future__ import annotations

import inspect
from pathlib import Path
from typing import Any

import numpy as np


def _identity_decorator(method=None, **_kwargs):
    if method is None:
        return lambda m: m
    return method


def kernel_namespace() -> dict[str, Any]:
    import zinnia

    namespace = {name: getattr(zinnia, name) for name in dir(zinnia) if not name.startswith("_")}
    namespace["np"] = np
    namespace["zk_circuit"] = _identity_decorator
    namespace["zk_chip"] = _identity_decorator
    namespace["zk_external"] = _identity_decorator
    return namespace


def run_kernel_as_numpy(kernel_path: Path, function: str, args: list[Any]) -> Any:
    """Execute the kernel file with the shims above and call `function(*args)`."""
    return run_kernel_with_arguments(kernel_path, function, args)[0]


def run_kernel_with_arguments(kernel_path: Path, function: str,
                              args: list[Any]) -> tuple[Any, dict[str, Any]]:
    """Like `run_kernel_as_numpy`, and also return the arguments after the call
    by parameter name (a kernel that returns `None` outputs the arrays it wrote)."""
    source = kernel_path.read_text()
    # The real import would rebind the shims; Zinnia's names are already there.
    source = source.replace("from zinnia import *", "")
    namespace = kernel_namespace()
    exec(compile(source, str(kernel_path), "exec"), namespace)  # noqa: S102 - our own datasets
    call_args = [np.array(a, copy=True) if isinstance(a, np.ndarray) else a for a in args]
    kernel = namespace[function]
    result = kernel(*call_args)
    names = list(inspect.signature(kernel).parameters)
    return result, dict(zip(names, call_args))

