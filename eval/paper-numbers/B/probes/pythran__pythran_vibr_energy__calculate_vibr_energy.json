  "source": "def calculate_vibr_energy(harmonic: Float[Array, '16'], anharmonic: Float[Array, '16'], i: Float[Array, '16']):\n    bprobe_trace = []\n    bprobe_v0 = -harmonic\n    bprobe_trace.append((1, bprobe_v0))\n    bprobe_v1 = bprobe_v0 * i\n    bprobe_trace.append((2, bprobe_v1))\n    bprobe_v2 = i ** 2\n    bprobe_trace.append((5, bprobe_v2))\n    bprobe_v3 = anharmonic * bprobe_v2\n    bprobe_trace.append((4, bprobe_v3))\n    bprobe_v4 = bprobe_v1 - bprobe_v3\n    bprobe_trace.append((3, bprobe_v4))\n    bprobe_v5 = np.exp(bprobe_v4)\n    bprobe_trace.append((0, bprobe_v5))\n    return bprobe_trace",
