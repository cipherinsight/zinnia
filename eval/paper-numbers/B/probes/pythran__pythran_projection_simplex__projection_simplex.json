  "source": "def projection_simplex(v: Float[Array, '10'], z: Integer=1):\n    bprobe_trace = []\n    '\\n    Old implementation for test and benchmark purposes.\\n    The arguments v and z should be a vector and a scalar, respectively.\\n    '\n    n_features = v.shape[0]\n    bprobe_v0 = np.sort(v)\n    bprobe_trace.append((0, bprobe_v0))\n    bprobe_v1 = bprobe_v0[::-1]\n    bprobe_trace.append((1, bprobe_v1))\n    u = bprobe_v1\n    bprobe_v2 = np.cumsum(u)\n    bprobe_trace.append((2, bprobe_v2))\n    bprobe_v3 = bprobe_v2 - z\n    bprobe_trace.append((3, bprobe_v3))\n    cssv = bprobe_v3\n    bprobe_v4 = np.arange(n_features)\n    bprobe_trace.append((4, bprobe_v4))\n    bprobe_v5 = bprobe_v4 + 1\n    bprobe_trace.append((5, bprobe_v5))\n    ind = bprobe_v5\n    bprobe_v6 = cssv / ind\n    bprobe_trace.append((8, bprobe_v6))\n    bprobe_v7 = u - bprobe_v6\n    bprobe_trace.append((6, bprobe_v7))\n    bprobe_v8 = bprobe_v7 > 0\n    bprobe_trace.append((7, bprobe_v8))\n    cond = bprobe_v8\n    bprobe_v9 = ind[cond]\n    bprobe_trace.append((9, bprobe_v9))\n    rho = bprobe_v9[-1]\n    bprobe_v10 = cssv[cond]\n    bprobe_trace.append((10, bprobe_v10))\n    theta = bprobe_v10[-1] / float(rho)\n    bprobe_v11 = v - theta\n    bprobe_trace.append((11, bprobe_v11))\n    bprobe_v12 = np.maximum(bprobe_v11, 0)\n    bprobe_trace.append((12, bprobe_v12))\n    w = bprobe_v12\n    return bprobe_trace",
