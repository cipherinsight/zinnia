  "source": "def tri(score: Integer[Array, '10 10'], score_t: Integer[Array, '10 10']):\n    bprobe_trace = []\n    score_t[0, 0] = score[0, 0]\n    bprobe_v0 = score[:, 1]\n    bprobe_trace.append((2, bprobe_v0))\n    bprobe_v1 = np.argsort(bprobe_v0)\n    bprobe_trace.append((1, bprobe_v1))\n    bprobe_v2 = score[bprobe_v1]\n    bprobe_trace.append((0, bprobe_v2))\n    score_t = bprobe_v2\n    return bprobe_trace",
