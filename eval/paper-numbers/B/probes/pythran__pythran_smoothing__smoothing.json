  "source": "def smoothing(x: Float[Array, '16'], alpha: Float):\n    bprobe_trace = []\n    '\\n  Exponential smoothing of a time series\\n  For x = 10**6 floats\\n  - Python runtime: 9 seconds\\n  - Parakeet runtime: .01 seconds\\n  '\n    bprobe_v0 = x.copy()\n    bprobe_trace.append((0, bprobe_v0))\n    s = bprobe_v0\n    for i in range(1, len(x)):\n        s[i] = alpha * x[i] + (1 - alpha) * s[i - 1]\n    return bprobe_trace",
