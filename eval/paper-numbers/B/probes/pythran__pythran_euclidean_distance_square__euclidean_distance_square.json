  "source": "def euclidean_distance_square(x1: Float[Array, '1 3'], x2: Float[Array, '5 3']):\n    bprobe_trace = []\n    bprobe_v0 = x2.T\n    bprobe_trace.append((4, bprobe_v0))\n    bprobe_v1 = np.dot(x1, bprobe_v0)\n    bprobe_trace.append((3, bprobe_v1))\n    bprobe_v2 = -2 * bprobe_v1\n    bprobe_trace.append((1, bprobe_v2))\n    bprobe_v3 = np.square(x1)\n    bprobe_trace.append((7, bprobe_v3))\n    bprobe_v4 = np.sum(bprobe_v3, axis=1)\n    bprobe_trace.append((5, bprobe_v4))\n    bprobe_v5 = bprobe_v4[:, np.newaxis]\n    bprobe_trace.append((6, bprobe_v5))\n    bprobe_v6 = bprobe_v2 + bprobe_v5\n    bprobe_trace.append((2, bprobe_v6))\n    bprobe_v7 = np.square(x2)\n    bprobe_trace.append((9, bprobe_v7))\n    bprobe_v8 = np.sum(bprobe_v7, axis=1)\n    bprobe_trace.append((8, bprobe_v8))\n    bprobe_v9 = bprobe_v6 + bprobe_v8\n    bprobe_trace.append((0, bprobe_v9))\n    return bprobe_trace",
