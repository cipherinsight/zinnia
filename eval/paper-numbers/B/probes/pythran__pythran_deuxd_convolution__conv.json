  ],
  "source": "def conv(x: Float[Array, '16 16'], weights: Float[Array, '5 5']):\n    bprobe_trace = []\n    sx = x.shape\n    sw = weights.shape\n    bprobe_v0 = np.zeros_like(x)\n    bprobe_trace.append((0, bprobe_v0))\n    result = bprobe_v0\n    for i in range(sx[0]):\n        for j in range(sx[1]):\n            for ii in range(sw[0]):\n                for jj in range(sw[1]):\n                    idx = (clamp(i, ii - sw[0] // 2, sw[0]), clamp(j, jj - sw[0] // 2, sw[0]))\n                    result[i, j] += x[idx] * weights[ii, jj]\n    return bprobe_trace",
