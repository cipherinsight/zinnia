  "source": "def factorMatrix0(M: Float[Array, '5 5']):\n    bprobe_trace = []\n    n = M.shape[0]\n    m = M.shape[1]\n    for line in range(0, n - 1):\n        bprobe_v0 = M[line:n, line]\n        bprobe_trace.append((1, bprobe_v0))\n        bprobe_v1 = abs(bprobe_v0)\n        bprobe_trace.append((0, bprobe_v1))\n        cmax = np.argmax(bprobe_v1) + line\n        if cmax != line:\n            M[[line, cmax]] = M[[cmax, line]]\n        pivot = M[line, line]\n        for j in range(line + 1, n):\n            v = M[j, line] / pivot\n            for k in range(line, m):\n                M[j, k] -= v * M[line, k]\n    return bprobe_trace",
