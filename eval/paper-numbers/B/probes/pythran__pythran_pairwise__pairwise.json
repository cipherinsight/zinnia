  ],
  "source": "def pairwise(X: Float[Array, '16 8']):\n    bprobe_trace = []\n    M, N = X.shape\n    bprobe_v0 = np.empty((M, M))\n    bprobe_trace.append((0, bprobe_v0))\n    D = bprobe_v0\n    for i in range(M):\n        for j in range(M):\n            d = 0.0\n            for k in range(N):\n                tmp = X[i, k] - X[j, k]\n                d += tmp * tmp\n            D[i, j] = np.sqrt(d)\n    return bprobe_trace",
