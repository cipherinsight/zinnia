  "source": "def one_time_step(f1: Float[Array, '16 16 9'], f2: Float[Array, '16 16 9']):\n    bprobe_trace = []\n    nx, ny, ns = f1.shape\n    bprobe_v0 = np.zeros(ns)\n    bprobe_trace.append((0, bprobe_v0))\n    floc = bprobe_v0\n    bprobe_v1 = np.zeros(ns)\n    bprobe_trace.append((1, bprobe_v1))\n    mloc = bprobe_v1\n    periodic_bc(f1)\n    for i in range(1, nx - 1):\n        for j in range(1, ny - 1):\n            getf(f1, floc, i, j)\n            f2m_loc(floc, mloc)\n            relaxation_loc(mloc)\n            m2f_loc(mloc, floc)\n            setf(f2, floc, i, j)\n    return bprobe_trace",
