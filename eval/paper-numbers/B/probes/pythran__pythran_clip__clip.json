  "source": "def clip(z: Complex[Array, '2'], _max: Float):\n    bprobe_trace = []\n    bprobe_v0 = np.empty(z.shape, dtype=z.dtype)\n    bprobe_trace.append((0, bprobe_v0))\n    out = bprobe_v0\n    for i in range(len(z)):\n        if abs(z[i]) > _max:\n            out[i] = limit1(z[i]) * _max\n        else:\n            out[i] = z[i]\n    return bprobe_trace",
