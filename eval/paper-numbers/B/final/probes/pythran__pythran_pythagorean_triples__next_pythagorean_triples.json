  "source": "def next_pythagorean_triples(previous: Integer[Array, '1 3']):\n    bprobe_trace = []\n    bprobe_v0 = np.array([[-1, 2, 2], [-2, 1, 2], [-2, 2, 3], [1, 2, 2], [2, 1, 2], [2, 2, 3], [1, -2, 2], [2, -1, 2], [2, -2, 3]])\n    bprobe_trace.append((0, bprobe_v0))\n    matrices = bprobe_v0\n    bprobe_v1 = np.transpose(previous)\n    bprobe_trace.append((3, bprobe_v1))\n    bprobe_v2 = np.dot(matrices, bprobe_v1)\n    bprobe_trace.append((2, bprobe_v2))\n    bprobe_v3 = np.transpose(bprobe_v2)\n    bprobe_trace.append((1, bprobe_v3))\n    next_triples = bprobe_v3\n    bprobe_v4 = next_triples.reshape((3 * previous.shape[0], previous.shape[1]))\n    bprobe_trace.append((4, bprobe_v4))\n    next_triples = bprobe_v4\n    return bprobe_trace",
