  "source": "def rosen(x: Float[Array, '16']):\n    bprobe_trace = []\n    bprobe_v0 = x[1:]\n    bprobe_trace.append((1, bprobe_v0))\n    bprobe_v1 = x[:-1]\n    bprobe_trace.append((3, bprobe_v1))\n    bprobe_v2 = bprobe_v1 ** 2\n    bprobe_trace.append((4, bprobe_v2))\n    bprobe_v3 = bprobe_v0 - bprobe_v2\n    bprobe_trace.append((2, bprobe_v3))\n    bprobe_v4 = bprobe_v3 ** 2\n    bprobe_trace.append((0, bprobe_v4))\n    bprobe_v5 = 100 * bprobe_v4\n    bprobe_trace.append((5, bprobe_v5))\n    t0 = bprobe_v5\n    bprobe_v6 = x[:-1]\n    bprobe_trace.append((7, bprobe_v6))\n    bprobe_v7 = 1 - bprobe_v6\n    bprobe_trace.append((6, bprobe_v7))\n    bprobe_v8 = bprobe_v7 ** 2\n    bprobe_trace.append((8, bprobe_v8))\n    t1 = bprobe_v8\n    bprobe_v9 = t0 + t1\n    bprobe_trace.append((9, bprobe_v9))\n    return bprobe_trace",
