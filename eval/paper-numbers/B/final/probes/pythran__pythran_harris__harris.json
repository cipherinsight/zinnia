  "source": "def harris(I: Float[Array, '4 6']):\n    bprobe_trace = []\n    m, n = I.shape\n    bprobe_v0 = I[1:, :]\n    bprobe_trace.append((0, bprobe_v0))\n    bprobe_v1 = I[:m - 1, :]\n    bprobe_trace.append((2, bprobe_v1))\n    bprobe_v2 = bprobe_v0 - bprobe_v1\n    bprobe_trace.append((1, bprobe_v2))\n    bprobe_v3 = bprobe_v2[:, 1:]\n    bprobe_trace.append((3, bprobe_v3))\n    dx = bprobe_v3\n    bprobe_v4 = I[:, 1:]\n    bprobe_trace.append((4, bprobe_v4))\n    bprobe_v5 = I[:, :n - 1]\n    bprobe_trace.append((6, bprobe_v5))\n    bprobe_v6 = bprobe_v4 - bprobe_v5\n    bprobe_trace.append((5, bprobe_v6))\n    bprobe_v7 = bprobe_v6[1:, :]\n    bprobe_trace.append((7, bprobe_v7))\n    dy = bprobe_v7\n    bprobe_v8 = dx * dx\n    bprobe_trace.append((8, bprobe_v8))\n    A = bprobe_v8\n    bprobe_v9 = dy * dy\n    bprobe_trace.append((9, bprobe_v9))\n    B = bprobe_v9\n    bprobe_v10 = dx * dy\n    bprobe_trace.append((10, bprobe_v10))\n    C = bprobe_v10\n    bprobe_v11 = A + B\n    bprobe_trace.append((11, bprobe_v11))\n    tr = bprobe_v11\n    bprobe_v12 = A * B\n    bprobe_trace.append((12, bprobe_v12))\n    bprobe_v13 = C * C\n    bprobe_trace.append((14, bprobe_v13))\n    bprobe_v14 = bprobe_v12 - bprobe_v13\n    bprobe_trace.append((13, bprobe_v14))\n    det = bprobe_v14\n    k = 0.05\n    bprobe_v15 = k * tr\n    bprobe_trace.append((16, bprobe_v15))\n    bprobe_v16 = bprobe_v15 * tr\n    bprobe_trace.append((17, bprobe_v16))\n    bprobe_v17 = det - bprobe_v16\n    bprobe_trace.append((15, bprobe_v17))\n    return bprobe_trace",
