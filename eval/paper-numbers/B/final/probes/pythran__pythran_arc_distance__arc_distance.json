  "source": "def arc_distance(theta_1: Float[Array, '5'], phi_1: Float[Array, '5'], theta_2: Float[Array, '5'], phi_2: Float[Array, '5']):\n    bprobe_trace = []\n    '\\n    Calculates the pairwise arc distance between all points in vector a and b.\\n    '\n    bprobe_v0 = theta_2 - theta_1\n    bprobe_trace.append((4, bprobe_v0))\n    bprobe_v1 = bprobe_v0 / 2\n    bprobe_trace.append((3, bprobe_v1))\n    bprobe_v2 = np.sin(bprobe_v1)\n    bprobe_trace.append((1, bprobe_v2))\n    bprobe_v3 = bprobe_v2 ** 2\n    bprobe_trace.append((2, bprobe_v3))\n    bprobe_v4 = np.cos(theta_1)\n    bprobe_trace.append((6, bprobe_v4))\n    bprobe_v5 = np.cos(theta_2)\n    bprobe_trace.append((8, bprobe_v5))\n    bprobe_v6 = bprobe_v4 * bprobe_v5\n    bprobe_trace.append((7, bprobe_v6))\n    bprobe_v7 = phi_2 - phi_1\n    bprobe_trace.append((12, bprobe_v7))\n    bprobe_v8 = bprobe_v7 / 2\n    bprobe_trace.append((11, bprobe_v8))\n    bprobe_v9 = np.sin(bprobe_v8)\n    bprobe_trace.append((9, bprobe_v9))\n    bprobe_v10 = bprobe_v9 ** 2\n    bprobe_trace.append((10, bprobe_v10))\n    bprobe_v11 = bprobe_v6 * bprobe_v10\n    bprobe_trace.append((5, bprobe_v11))\n    bprobe_v12 = bprobe_v3 + bprobe_v11\n    bprobe_trace.append((0, bprobe_v12))\n    temp = bprobe_v12\n    bprobe_v13 = np.sqrt(temp)\n    bprobe_trace.append((15, bprobe_v13))\n    bprobe_v14 = 1 - temp\n    bprobe_trace.append((17, bprobe_v14))\n    bprobe_v15 = np.sqrt(bprobe_v14)\n    bprobe_trace.append((16, bprobe_v15))\n    bprobe_v16 = np.arctan2(bprobe_v13, bprobe_v15)\n    bprobe_trace.append((14, bprobe_v16))\n    bprobe_v17 = 2 * bprobe_v16\n    bprobe_trace.append((13, bprobe_v17))\n    distance_matrix = bprobe_v17\n    return bprobe_trace",
