  "source": "def slow_wdist(A: Float[Array, '2 3'], B: Float[Array, '2 3'], W: Float[Array, '2 3']):\n    bprobe_trace = []\n    k, m = A.shape\n    _, n = B.shape\n    bprobe_v0 = np.zeros((m, n))\n    bprobe_trace.append((0, bprobe_v0))\n    D = bprobe_v0\n    for ii in range(m):\n        for jj in range(n):\n            bprobe_v1 = A[:, ii]\n            bprobe_trace.append((2, bprobe_v1))\n            bprobe_v2 = B[:, jj]\n            bprobe_trace.append((4, bprobe_v2))\n            bprobe_v3 = bprobe_v1 - bprobe_v2\n            bprobe_trace.append((3, bprobe_v3))\n            bprobe_v4 = W[:, ii]\n            bprobe_trace.append((5, bprobe_v4))\n            bprobe_v5 = bprobe_v3 / bprobe_v4\n            bprobe_trace.append((1, bprobe_v5))\n            wdiff = bprobe_v5\n            bprobe_v6 = wdiff ** 2\n            bprobe_trace.append((6, bprobe_v6))\n            D[ii, jj] = np.sqrt(bprobe_v6.sum())\n    return bprobe_trace",
