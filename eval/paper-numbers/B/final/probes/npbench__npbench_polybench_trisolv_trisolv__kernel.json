  "source": "def kernel(L: Float[Array, '16 16'], x: Float[Array, '16'], b: Float[Array, '16']):\n    bprobe_trace = []\n    for i in range(x.shape[0]):\n        bprobe_v0 = L[i, :i]\n        bprobe_trace.append((0, bprobe_v0))\n        bprobe_v1 = x[:i]\n        bprobe_trace.append((1, bprobe_v1))\n        x[i] = (b[i] - bprobe_v0 @ bprobe_v1) / L[i, i]\n    return bprobe_trace",
