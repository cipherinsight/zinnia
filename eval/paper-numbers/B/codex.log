def collect(p):
 name=measure.ident(p);r=json.loads((measure.HERE/'probes'/(name+'.json')).read_text());c=json.loads((measure.HERE/'census'/(name+'.json')).read_text())
 rows=[];issues=[]
 labels={}
 for x in r.get('layout',[]):
  path=x['output'].get('return',[])
