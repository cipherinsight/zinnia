use std::collections::HashMap;

use crate::builder::IRBuilder;
use crate::types::{DynArrayMeta, DynamicNDArrayData, NumberType, ScalarValue, SliceIndex, Value, ValueId};

use super::{
    dyn_decode_coords, dyn_encode_coords, dyn_num_elements, dyn_row_major_strides,
    value_to_scalar_i64,
};

fn cast_to_dtype(b: &mut IRBuilder, value: &Value, dtype: NumberType) -> Value {
    match dtype {
        NumberType::Integer => b.ir_int_cast(value),
        NumberType::Float => b.ir_float_cast(value),
        NumberType::Complex => {
            let (real, imag) = crate::helpers::value_ops::unpack_value_to_complex_parts(b, value);
            crate::helpers::value_ops::pack_complex_value(real, imag)
        }
    }
}

/// Output of the shared boolean-mask compaction network ([`compact_by_mask`]).
pub(crate) struct Compaction {
    /// The compacted, default-padded buffer (`leading_total * trailing_total`
    /// elements): kept blocks packed to the front in source order, defaults
    /// behind.
    pub acc: Vec<Value>,
    /// Number of KEPT leading blocks (rows). This is the runtime row count,
    /// NOT multiplied by `trailing_total`.
    pub kept_rows: Value,
}

/// The single boolean-mask compaction network. `cast_cells` is the source
/// payload already cast to `default_val`'s dtype (`leading_total *
/// trailing_total` cells, row-major); `mask_cells` carries one mask cell per
/// leading block. Returns the compacted buffer plus the kept-row count.
///
/// Compaction via a one-hot shift network — no memory ops. `row[j]` one-hot
/// encodes the landing *row* of input block i (the prefix count of kept rows
/// before i): it starts as e_0 and shifts right by one whenever a row is
/// kept. Each input row select-writes its (masked) cells into the landing
/// row: kept rows deposit their values, non-kept rows deposit defaults at the
/// still-unowned next free row — exactly the previous write-pointer
/// semantics, so the output layout is bit-identical (compacted rows, default
/// padding). The row region is triangular (landing row <= i), so entries
/// beyond i+1 stay constant 0 and emit nothing.
///
/// With a zero default (every real dtype), slot `j` is accumulated as the
/// sum `sum_i row_i[j] * deposit_i` instead of a chain of selects: the rows
/// whose landing row is `j` are the run of non-kept rows after the j-th kept
/// row, which deposit 0, and the (j+1)-th kept row itself, so the sum is
/// that row's value, or 0 when fewer rows are kept, as the select chain
/// gives. The sum costs one product and one addition per term and needs no
/// bit check of the one-hot entry, which a select's condition does.
///
/// This is the SINGLE copy of the triangular shift loop: `dynamic_mask_read`
/// (StaticArray boolean-mask read, trailing tail support) and `dyn_filter`
/// (DynamicNDArray `arr[mask]` / `.filter`, trailing_total == 1) both call it.
pub(crate) fn compact_by_mask(
    b: &mut IRBuilder,
    cast_cells: &[Value],
    mask_cells: &[Value],
    default_val: &Value,
    trailing_total: usize,
) -> Compaction {
    let trailing_total = trailing_total.max(1);
    let leading_total = mask_cells.len();
    let total = leading_total * trailing_total;
    debug_assert_eq!(cast_cells.len(), total);

    let one = b.ir_constant_int(1);
    let zero = b.ir_constant_int(0);
    let mut row: Vec<Value> = (0..leading_total)
        .map(|j| if j == 0 { one.clone() } else { zero.clone() })
        .collect();
    let mut acc: Vec<Value> = vec![default_val.clone(); total];
    let mut kept_rows = b.ir_constant_int(0);

    let is_const_zero = |v: &Value| v.int_val() == Some(0);
    let zero_default = is_zero_scalar(default_val);
    // With a zero default, the `(one-hot entry, deposit)` terms of each slot,
    // summed after the network so that each slot's sum is one contiguous
    // multiply-add chain (backends chain consecutive multiply-adds).
    let mut terms: Vec<Vec<(Value, Value)>> = vec![Vec::new(); total];

    for i in 0..leading_total {
        let mask_bool = ensure_bool(b, &mask_cells[i]);
        let mut deposit: Vec<Value> = Vec::with_capacity(trailing_total);
        for t in 0..trailing_total {
            let src = &cast_cells[i * trailing_total + t];
            deposit.push(crate::helpers::value_ops::select_value(
                b,
                &mask_bool,
                src,
                default_val,
            ));
        }

        for j in 0..(i + 1).min(leading_total) {
            if is_const_zero(&row[j]) {
                continue;
            }
            for (t, dep) in deposit.iter().enumerate() {
                let slot = &acc[j * trailing_total + t];
                if zero_default {
                    terms[j * trailing_total + t].push((row[j].clone(), dep.clone()));
                } else {
                    acc[j * trailing_total + t] = crate::helpers::value_ops::select_value(b, &row[j], dep, slot);
                }
            }
        }

        // Shift the one-hot row right when this input row was kept.
        let mut new_row = row.clone();
        for j in (0..(i + 2).min(leading_total)).rev() {
            let prev = if j == 0 { &zero } else { &row[j - 1] };
            if is_const_zero(prev) && is_const_zero(&row[j]) {
                continue;
            }
            new_row[j] = b.ir_select_i(&mask_bool, prev, &row[j]);
        }
        row = new_row;

        let inc = b.ir_select_i(&mask_bool, &one, &zero);
        kept_rows = b.ir_add_i(&kept_rows, &inc);
    }
    for (slot, slot_terms) in terms.into_iter().enumerate() {
        for (hit, dep) in slot_terms {
            acc[slot] = add_weighted(b, &acc[slot], &hit, &dep);
        }
    }

    Compaction { acc, kept_rows }
}

/// Whether `v` is a real (not complex) compile-time zero.
fn is_zero_scalar(v: &Value) -> bool {
    v.int_val() == Some(0) || v.float_val() == Some(0.0)
}

/// `acc + hit * value` for a 0/1 `hit`, as a field product and sum (no
/// rescale: a Float `value` is scaled by 0 or 1), typed as `value`.
fn add_weighted(b: &mut IRBuilder, acc: &Value, hit: &Value, value: &Value) -> Value {
    let product = b.create_ir(&crate::ir_defs::IR::MulI, &[hit.clone(), value.clone()]);
    let term = match (product, value) {
        (Value::Integer(sv), Value::Float(_)) => Value::Float(ScalarValue {
            static_val: None,
            stmt_id: sv.stmt_id,
            value_id: sv.value_id,
        }),
        (product, _) => product,
    };
    match (acc, value) {
        _ if is_zero_scalar(acc) => term,
        (_, Value::Float(_)) => b.ir_add_f(acc, &term),
        _ => b.ir_add_i(acc, &term),
    }
}

fn ensure_bool(b: &mut IRBuilder, v: &Value) -> Value {
    match v {
        Value::Boolean(_) => v.clone(),
        _ => b.ir_bool_cast(v),
    }
}

pub fn dyn_filter(b: &mut IRBuilder, data: &DynamicNDArrayData, args: &[Value]) -> Value {
    let mask = args.first().expect("filter: requires a mask argument");
    let data_owned = super::force_contiguous(b, data);
    let data = &data_owned;
    let max_len = data.max_length();
    let target_shape = &data.meta.logical_shape;
    let elements: Vec<Value> =
        crate::helpers::segment::read_all_typed(b, data.segment_id, max_len, data.dtype);

#!/usr/bin/env python3
"""Gate counts (`bb gates` circuit size) of the performance-set Noir circuits.

Sources (one per run):
  --zinnia          emit each case's `main.nr` with the installed Zinnia build
                    (`emit_structural` on fixture input B; the circuit text does
                    not depend on the input values, only on their shapes) and
                    stage it with `noir_fpc`;
  --zinnia-dir DIR  pre-rendered Zinnia circuits `DIR/<case>.nr`, with `noir_fpc`;
  --baselines       the handwritten `datasets/ds1000/<case>/main.nr`, staged with
                    `baselines/noir_hw` exactly as `hw_check.noir_driver setup`
                    stages it (the number `hw_check.check` records as `gates`).

Both sides are compiled with `nargo compile` and sized with `bb gates
--scheme ultra_honk --verifier_target noir-recursive` (zero-knowledge
UltraHonk, the target of the harness and of Zinnia's Noir driver). Cases
default to every `perf` case of `datasets/case_sets/ds1000_perf.json`. Each
case runs in a child process with a timeout; `--wrap` prefixes the child
command (e.g. a memory cap); `--jobs` runs that many children at once.

    .venv/bin/python benchmarking/noir_gates.py --zinnia --out zn.json [--emit-dir DIR]
    .venv/bin/python benchmarking/noir_gates.py --baselines --out hw.json
    .venv/bin/python benchmarking/noir_gates.py --compare zn.json hw.json [--markdown]
"""

from __future__ import annotations

import argparse
import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
ROOT = THIS_DIR.parent
DATASET = THIS_DIR / "datasets" / "ds1000"
CASE_SET = THIS_DIR / "datasets" / "case_sets" / "ds1000_perf.json"
NOIR_FPC = THIS_DIR / "noir_fpc"
NOIR_HW = THIS_DIR / "baselines" / "noir_hw"
PROVE_INPUT = "B"
os.environ.setdefault("ZINNIA_SKIP_RELEASE_BUILD", "1")
BB_FLAGS = ("--scheme", "ultra_honk", "--verifier_target", "noir-recursive")


def tool(env: str, home_rel: str, name: str) -> str:
    explicit = os.environ.get(env)
    if explicit:
        return explicit
    home = Path.home() / home_rel
    return str(home) if home.is_file() else (shutil.which(name) or name)


NARGO = tool("ZINNIA_NARGO_BIN", ".nargo/bin/nargo", "nargo")
BB = tool("ZINNIA_BB_BIN", ".bb/bb", "bb")


def case_name(spec: str) -> str:
    return spec if spec.startswith("ds1000_case") else f"ds1000_case{spec}"


def perf_cases() -> list[str]:
    """Every case whose status in the performance case set is `perf`."""
    entries = json.loads(CASE_SET.read_text())["cases"]
    return sorted(e["case"] for e in entries if e["status"] == "perf")


def load_case(case: str):
    """(compiled program, kernel arguments of `input_name`) for one perf case."""
    sys.path.insert(0, str(ROOT))
    from benchmarking.harness.fixtures import load_fixture
    from benchmarking.harness.kernels import compile_kernel

    directory = DATASET / case
    fixture = load_fixture(directory / "fixture.json")
    compiled = compile_kernel(directory / "kernel.py", fixture.function, backend="noir")
    return compiled, fixture


def zinnia_main_nr(case: str) -> str:
    compiled, fixture = load_case(case)
    return compiled.emit_structural(*fixture.arguments(PROVE_INPUT), backend="noir")


def gate_count(main_nr: str, library: str, library_dir: Path) -> dict:
    """`nargo compile` + `bb gates` of `main.nr` depending on one library."""
    with tempfile.TemporaryDirectory(prefix="noir-gates-") as tmp:
        pkg = Path(tmp)
        (pkg / "src").mkdir()
        (pkg / "src" / "main.nr").write_text(main_nr)
        shutil.copytree(library_dir, pkg / library, ignore=shutil.ignore_patterns("target"))
        (pkg / "Nargo.toml").write_text(
            '[package]\nname = "circuit"\ntype = "bin"\nauthors = [""]\n\n'
            f'[dependencies]\n{library} = {{ path = "./{library}" }}\n')
        proc = subprocess.run([NARGO, "compile", "--silence-warnings"], cwd=pkg,
                              capture_output=True, text=True)
        if proc.returncode != 0:
            return {"error": "nargo compile: " + (proc.stdout + proc.stderr)[-1500:]}
        proc = subprocess.run([BB, "gates", "-b", str(pkg / "target" / "circuit.json"), *BB_FLAGS],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            return {"error": "bb gates: " + (proc.stdout + proc.stderr)[-1500:]}
        document, _ = json.JSONDecoder().raw_decode(proc.stdout[proc.stdout.find("{"):])
        fn = document["functions"][0]
        return {"gates": fn["circuit_size"], "acir_opcodes": fn["acir_opcodes"]}


def child(case: str, source: str, source_dir: str | None, emit_dir: str | None) -> dict:
    try:
        if source == "zinnia":
            main_nr = zinnia_main_nr(case)
            if emit_dir:
                Path(emit_dir).mkdir(parents=True, exist_ok=True)
                (Path(emit_dir) / f"{case}.nr").write_text(main_nr)
        elif source == "zinnia-dir":
            main_nr = (Path(source_dir) / f"{case}.nr").read_text()
        else:
            main_nr = (DATASET / case / "main.nr").read_text()
    except BaseException as e:  # noqa: BLE001 - PyO3 panics derive from BaseException
        return {"error": f"source: {type(e).__name__}: {e}"[:1500]}
    if source == "baselines":
        return gate_count(main_nr, "noir_hw", NOIR_HW)
    return gate_count(main_nr, "noir_fpc", NOIR_FPC)


def geomean(xs: list[float]) -> float:
    return math.exp(sum(math.log(x) for x in xs) / len(xs)) if xs else float("nan")


def compare(zinnia_json: Path, baseline_json: Path, markdown: bool) -> int:
    """Per-case Zinnia/handwritten ratio, worst first, and the geomean."""
    zn = json.loads(zinnia_json.read_text())
    hw = json.loads(baseline_json.read_text())
    rows = []
    for case in sorted(set(zn) | set(hw)):
        z, h = zn.get(case, {}).get("gates"), hw.get(case, {}).get("gates")
        rows.append((case, z, h, z / h if z and h else None))
    rows.sort(key=lambda r: (r[3] is None, -(r[3] or 0)))
    ratios = [r[3] for r in rows if r[3] is not None]
    if markdown:
        print("| case | Zinnia | handwritten | Zinnia/hw |\n|---|---|---|---|")
        for case, z, h, r in rows:
            print(f"| {case.removeprefix('ds1000_case')} | {z if z is not None else '-'} "
                  f"| {h if h is not None else '-'} | {f'{r:.3f}' if r else '-'} |")
    else:
        for case, z, h, r in rows:
            print(f"{case}  {z!s:>8}  {h!s:>8}  {f'{r:.3f}' if r else '-'}")
    print(f"pairs {len(ratios)}  geomean {geomean(ratios):.4f}  "
          f"Zinnia cheaper on {sum(r < 1 for r in ratios)}, "
          f"costlier on {sum(r > 1 for r in ratios)}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--zinnia", action="store_true")
    src.add_argument("--zinnia-dir")
    src.add_argument("--baselines", action="store_true")
    src.add_argument("--compare", nargs=2, metavar=("ZINNIA_JSON", "BASELINE_JSON"))
    ap.add_argument("--markdown", action="store_true", help="--compare: a markdown table")

class NoirPackage:
    """A Noir binary package: `Nargo.toml`, `src/main.nr`, vendored `noir_fpc/`."""

    def __init__(self, directory: Path, name: str):
        self.directory = directory
        self.name = name

    @staticmethod
    def create(directory: Path, name: str, main_nr: str,
               libraries: dict[str, Path] | None = None) -> "NoirPackage":
        """A fresh package with `libraries` (name -> source folder) copied in.

        The default library is `noir_fpc`, the only one Zinnia's emitted code uses.
        """
        libraries = {"noir_fpc": paths.NOIR_FPC} if libraries is None else libraries
        if directory.exists():
            shutil.rmtree(directory)
        (directory / "src").mkdir(parents=True)
        (directory / "src" / "main.nr").write_text(main_nr)
        dependencies = "".join(f'{lib} = {{ path = "./{lib}" }}\n' for lib in libraries)
        (directory / "Nargo.toml").write_text(
            f'[package]\nname = "{name}"\ntype = "bin"\nauthors = [""]\n\n'
            f"[dependencies]\n{dependencies}")
        for lib, source in libraries.items():
            shutil.copytree(source, directory / lib, ignore=shutil.ignore_patterns("target"))
        return NoirPackage(directory, name)

    @property
    def target(self) -> Path:
        return self.directory / "target"

    @property
    def bytecode(self) -> Path:
        return self.target / f"{self.name}.json"

    @property
    def vk(self) -> Path:
        return self.target / "vk"

    def write_inputs(self, prover_name: str, toml: str) -> None:
        (self.directory / f"{prover_name}.toml").write_text(toml)

    def compile(self) -> float:
        seconds, _ = run_tool([str(toolchains.nargo_path()), "compile"], cwd=self.directory,
                              failure_class="unsupported")
        return seconds

    def execute(self, prover_name: str, witness_name: str) -> tuple[float, Path]:
        """`nargo execute` with `<prover_name>.toml`: elaborates the package source again,
        checks it against the compiled artifact, then runs the ACIR."""
        seconds, _ = run_tool([str(toolchains.nargo_path()), "execute", "--prover-name",
                               prover_name, witness_name],
                              cwd=self.directory, failure_class="prove_failed")
        return seconds, self.target / f"{witness_name}.gz"

    def execute_artifact(self, prover_name: str, witness_name: str) -> tuple[float, Path]:
        """`noir-execute` with `<prover_name>.toml` on the compiled artifact alone."""
        seconds, _ = run_tool([str(toolchains.noir_execute_path()),
                               "--artifact-path", str(self.bytecode),
                               "--prover-file", str(self.directory / f"{prover_name}.toml"),
                               "--output-dir", str(self.target),
                               "--witness-name", witness_name],
                              cwd=self.directory, failure_class="prove_failed")
        return seconds, self.target / f"{witness_name}.gz"

    def write_vk(self) -> float:
        seconds, _ = run_tool([str(toolchains.bb_path()), "write_vk", "-b", str(self.bytecode),
                               "-o", str(self.target), *BB_FLAGS],
                              cwd=self.directory, failure_class="setup_failed")
        return seconds

    def gates(self) -> dict:
        """`bb gates` for the compiled circuit (circuit size, ACIR opcodes)."""
        _, output = run_tool([str(toolchains.bb_path()), "gates", "-b", str(self.bytecode),
                              *BB_FLAGS], cwd=self.directory, failure_class="setup_failed")
        start = output.find("{")
        try:  # bb prints a status line after the JSON document
            document, _ = json.JSONDecoder().raw_decode(output[start:])
            functions = document.get("functions") or [{}]
        except (ValueError, AttributeError):
            return {"unparsed": output[-300:]}
        first = functions[0]
        return {"circuit_size": first.get("circuit_size"),
                "acir_opcodes": first.get("acir_opcodes")}

    def prove(self, witness: Path, out_dir: Path) -> float:
        out_dir.mkdir(parents=True, exist_ok=True)
        seconds, _ = run_tool([str(toolchains.bb_path()), "prove", "-b", str(self.bytecode),
                               "-w", str(witness), "-k", str(self.vk), "-o", str(out_dir),
                               *BB_FLAGS], cwd=self.directory, failure_class="prove_failed")
        return seconds

