# pythran program fibo_seq.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
@requires(lambda n: 0 <= n <= 1024)
def fibo(n: Integer):
    """ fibonaccie compuation. """
    a, b = (1, 1)
    for _ in range(n):
        a, b = (a + b, a)
    return a
# pythran program ccopy.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
@requires(lambda N, CX, INCX, CY, INCY: 0 <= N <= 1024)
def CCOPY(N: Integer, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
    if N <= 0:
        return
    if INCX == 1 and INCY == 1:
        for I in range(N):
            CY[I] = CX[I]
    else:
        IX = 0
        IY = 0
        if INCX < 0:
            IX = (-N + 1) * INCX
        if INCY < 0:
            IY = (-N + 1) * INCY
        for I in range(N):
            CY[IY] = CX[IX]
            IX = IX + INCX
            IY = IY + INCY
    return
