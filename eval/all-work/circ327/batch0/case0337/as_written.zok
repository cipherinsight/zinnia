def main(private field[8][10] a) -> field[8]:
    field[8][10] flipped = [[0; 10]; 8]
    for field i in 0..8 do
        for field j in 0..10 do
            flipped[i][j] = a[i][9-j]
        endfor
    endfor
    field[8] result = [0; 8]
    for field i in 0..8 do
        result[i] = flipped[i][i]
    endfor
    return result
