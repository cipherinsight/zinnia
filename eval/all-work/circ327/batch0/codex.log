from zinnia import *

@zk_circuit
@requires(lambda N, CA, CX, INCX, CY, INCY: 0 <= N <= 1024)
def CAXPY(N: Integer, CA: Complex, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
    if N <= 0:
        return
    if abs(CA) == 0.0:
        return
    if INCX == 1 and INCY == 1:
        'omp parallel for'
        for I in range(N):
            CY[I] = CY[I] + CA * CX[I]
    else:
        IX = 0
        IY = 0
        if INCX < 0:
            IX = (-N + 1) * INCX
        if INCY < 0:
            IY = (-N + 1) * INCY
        for I in range(N):
            CY[IY] = CY[IY] + CA * CX[IX]
            IX = IX + INCX
            IY = IY + INCY
    return CY

