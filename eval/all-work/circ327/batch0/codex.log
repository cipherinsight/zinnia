10:     tscores = itemscores.sum(0)
11:     nitems = len(itemscores)
12:     return nitems / (nitems - 1) * (1 - itemvars.sum() / tscores.var(None, None, None, 1))

### pythran_emin
5: from zinnia import *
7: @zk_chip
8: def Eandg(rOH, thetaHOH):
9:     """"
10:     Arguments: (internal coordinates of the water molecule)
12:     rOH            O-H bond distance
13:     thetaHOH       H-O-H bond angle
16:     Returns:
18:     E              Molecular force field energy
19:     grOH           O-H bond stretch gradient
20:     grthetaHOH     H-O-H bond angle bend gradient 
23:     Force field parameters:
25:     kOH            Harmonic force constant, O-H bond strech
26:     rOHe           Equilibrium distance, O-H
27:     kHOH           Harmonic angle bend force constant, H-O-H angle bend
28:     thetaHOHe      Equilibrium angle, H-O-H
30:     """
31:     kOH = 50.0
32:     rOHe = 0.95
33:     kHOH = 50.0
34:     thetaHOHe = 104.5
35:     E = 2 * kOH * (rOH - rOHe) ** 2 + kHOH * (thetaHOH - thetaHOHe) ** 2
36:     grOH = 2 * kOH * (rOH - rOHe)
37:     grthetaHOH = 2 * kHOH * (thetaHOH - thetaHOHe)
38:     return (E, grOH, grthetaHOH)
40: @zk_circuit
41: def run():
42:     c = 0.005
43:     n_steps = 1000000
44:     rOH = 10.0
45:     thetaHOH = 180.0
46:     for i in range(n_steps):
47:         E, grOH, gthetaHOH = Eandg(rOH, thetaHOH)
48:         if abs(grOH) > 0.001 / c or abs(gthetaHOH) > 0.01 / c:
49:             rOH = rOH - c * grOH
50:             thetaHOH = thetaHOH - c * gthetaHOH
51:     converged = abs(grOH) > 0.001 / c or abs(gthetaHOH) > 0.01 / c
52:     return (converged, E, rOH, thetaHOH)

### pythran_fdtd
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def fdtd(input_grid: Float[Array, '16 16'], steps: Integer):
10:     grid = input_grid.copy()
11:     old_grid = np.zeros_like(input_grid)
12:     previous_grid = np.zeros_like(input_grid)
13:     l_x = grid.shape[0]
14:     l_y = grid.shape[1]
15:     for i in range(steps):
16:         np.copyto(previous_grid, old_grid)
17:         np.copyto(old_grid, grid)
18:         for x in range(l_x):
19:             for y in range(l_y):
20:                 grid[x, y] = 0.0
21:                 if 0 < x + 1 < l_x:
22:                     grid[x, y] += old_grid[x + 1, y]
23:                 if 0 < x - 1 < l_x:
24:                     grid[x, y] += old_grid[x - 1, y]
25:                 if 0 < y + 1 < l_y:
26:                     grid[x, y] += old_grid[x, y + 1]
27:                 if 0 < y - 1 < l_y:
28:                     grid[x, y] += old_grid[x, y - 1]
29:                 grid[x, y] /= 2.0
30:                 grid[x, y] -= previous_grid[x, y]
31:     return grid

