### pythran_periodic_dist
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def dist(x: Float[Array, '16'], y: Float[Array, '16'], z: Float[Array, '16'], L: Integer, periodicX: Boolean, periodicY: Boolean, periodicZ: Boolean):
10:     """ Computes distances between all particles and places the result in a matrix such that the ij th matrix entry corresponds to the distance between particle i and j """
11:     N = len(x)
12:     xtemp = np.tile(x, (N, 1))
13:     dx = xtemp - xtemp.T
14:     ytemp = np.tile(y, (N, 1))
15:     dy = ytemp - ytemp.T
16:     ztemp = np.tile(z, (N, 1))
17:     dz = ztemp - ztemp.T
18:     if periodicX:
19:         dx[dx > L / 2] = dx[dx > L / 2] - L
20:         dx[dx < -L / 2] = dx[dx < -L / 2] + L
21:     if periodicY:
22:         dy[dy > L / 2] = dy[dy > L / 2] - L
23:         dy[dy < -L / 2] = dy[dy < -L / 2] + L
24:     if periodicZ:
25:         dz[dz > L / 2] = dz[dz > L / 2] - L
26:         dz[dz < -L / 2] = dz[dz < -L / 2] + L
27:     d = np.sqrt(dx ** 2 + dy ** 2 + dz ** 2)
28:     d[d == 0] = -1
29:     return (d, dx, dy, dz)

