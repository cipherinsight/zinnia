8: @zk_circuit
9: def factorMatrix0(M: Float[Array, '5 5']):
10:     n = M.shape[0]
11:     m = M.shape[1]
12:     for line in range(0, n - 1):
13:         cmax = np.argmax(abs(M[line:n, line])) + line
14:         if cmax != line:
