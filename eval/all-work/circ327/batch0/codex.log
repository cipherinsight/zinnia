### npbench_contour_integral_contour_integral
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def contour_integral(NR: Integer, NM: Integer, slab_per_bc: Integer, Ham: Complex[Array, '3 5 5'], int_pts: Complex[Array, '4'], Y: Complex[Array, '5 15']):
10:     P0 = np.zeros((NR, NM), dtype=np.complex128)
11:     P1 = np.zeros((NR, NM), dtype=np.complex128)
12:     for z in int_pts:
13:         Tz = np.zeros((NR, NR), dtype=np.complex128)
14:         for n in range(slab_per_bc + 1):
15:             zz = np.power(z, slab_per_bc / 2 - n)
16:             Tz += zz * Ham[n]
17:         if NR == NM:
18:             X = np.linalg.inv(Tz)
19:         else:
20:             X = np.linalg.solve(Tz, Y)
21:         if abs(z) < 1.0:
22:             X = -X
23:         P0 += X
24:         P1 += z * X
25:     return (P0, P1)

