def main(private field[100][200] a) -> field[5000][2][2]:
    field[5000][2][2] result = [[[0; 2]; 2]; 5000]
    for field j in 0..100 do
        for field i in 0..50 do
            for field k in 0..2 do
                for field l in 0..2 do
                    result[j*50+i][k][l] = a[i*2+k][j*2+l]
                endfor
            endfor
        endfor
    endfor
    return result
