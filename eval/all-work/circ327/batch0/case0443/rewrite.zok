struct Output {
    field[20] values
    field length
}
def main(private field[20] A, private field[3] B) -> Output:
    field[20] result = [0; 20]
    field count = 0
    for field i in 0..20 do
        bool member = false
        for field j in 0..3 do
            member = member || A[i] == B[j]
        endfor
        field ix = if count < 20 then count else 0 fi
        result[ix] = if member then A[i] else result[ix] fi
        count = count + if member then 1 else 0 fi
    endfor
    return Output {values: result, length: count}
