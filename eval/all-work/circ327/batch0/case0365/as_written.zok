const field HALF = 26217937587563095239723870254092982918845276250263818911301829349969290592256
def main(private field[100] a, private field pos, private field element) -> field[101]:
    field p = if pos > HALF then pos + 100 else pos fi
    field[101] result = [0; 101]
    for field i in 0..100 do
        field ix = if i < p then i else i+1 fi
        result[ix] = a[i]
    endfor
    result[p] = element * 4294967296
    return result
