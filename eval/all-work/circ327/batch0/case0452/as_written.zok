def main(private integer[5][4] X) -> integer[5][4]:
    integer[5] l1 = [0; 5]
    for u32 i in 0..5 do
        for u32 j in 0..4 do
            l1[i] = l1[i] + if X[i][j] < 0 then -X[i][j] else X[i][j] fi
        endfor
    endfor
    integer[5][4] result = [[0; 4]; 5]
    for u32 i in 0..5 do
        for u32 j in 0..4 do
            result[i][j] = X[i][j]*4294967296/l1[i]
        endfor
    endfor
    return result
