from "EMBED" import u32_to_field
from "utils/casts/field_to_u32" import main as idx

def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256

def lt(field x, field y) -> bool:
    return if neg(x) != neg(y) then neg(x) else x < y fi

def ab(field x) -> field:
    return if neg(x) then -x else x fi

def main(private field n, private field m) -> field[1048578]:
    field[1048578] result = [0; 1048578]
    result[0] = m
    result[1] = n
    return result
