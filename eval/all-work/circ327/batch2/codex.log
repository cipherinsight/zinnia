16: @zk_chip
17: def fibo(n):
18:     if n < 10:
19:         return rfibo(n)
20:     else:
21:         n_1 = 0
22:         'omp task shared(n,n_1)'
23:         n_1 = fibo(n - 1)
24:         n_2 = fibo(n - 2)
25:         'omp taskwait'
26:         return n_1 + n_2
28: @zk_circuit
29: @requires(lambda n: 0 <= n <= 1024)
30: def test(n: Integer):
31:     """omp parallel"""
32:     'omp single'
33:     f = fibo(n)
34:     return f

### pythran_guerre
5: from zinnia import *
7: @zk_circuit
8: @requires(lambda a, n, z, err, nter: 0 <= n <= 1024)
9: def guerre(a: Complex[Array, '4'], n: Integer, z: Complex, err: Float, nter: Integer):
10:     az = [complex(0, 0) for i in range(50)]
11:     azz = [complex(0, 0) for i in range(50)]
12:     ci = complex(0.0, 1.0)
13:     eps = 1e-20
14:     for i in range(1, n + 1):
15:         az[i - 1] = float(i) * a[i]
16:     for i in range(1, n):
17:         azz[i - 1] = float(i) * az[i]
18:     dz = err + 1
19:     itera = 0
20:     jter = 0
21:     while abs(dz) > err and itera < nter:
22:         p = a[n - 1] + a[n] * z
23:         for i in range(n - 1, 0, -1):
24:             p = a[i - 1] + z * p
25:         if abs(p) < eps:
26:             return z
27:         pz = az[n - 2] + az[n - 1] * z
28:         for i in range(n - 2, 0, -1):
29:             pz = az[i - 1] + z * pz
30:         pzz = azz[n - 3] + azz[n - 2] * z
31:         for i in range(n - 3, 0, -1):
32:             pzz = azz[i - 1] + z * pzz
33:         f = pz / p
34:         g = f ** 2 - pzz / p
35:         h = n * g
36:         amp1 = abs(f + h)
37:         amp2 = abs(f - h)
38:         if amp1 > amp2:
39:             dz = float(-n) / (f + h)
40:         else:
41:             dz = float(-n) / (f - h)
42:         itera = itera + 1
43:         jter = jter + 1
44:         if jter == 10:
45:             jter = 1
46:             dz = dz * ci
47:         z = z + dz
48:         if jter == 100:
49:             raise RuntimeError('Laguerre method not converging')
50:     return z

### pythran_ising
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def ising_step(field: Integer[Array, '2 2'], beta: Float=0.4):
10:     N, M = field.shape
11:     for n_offset in range(2):
12:         for m_offset in range(2):
13:             for n in range(n_offset, N, 2):
14:                 for m in range(m_offset, M, 2):
15:                     _ising_update(field, n, m, np.float32(beta))
16:     return field
18: @zk_chip
19: def clamp(v, n):
20:     if v < 0:
21:         return v + n
22:     elif v < n:
23:         return v
24:     else:
25:         return v - n
27: @zk_chip
28: def _ising_update(field, n, m, beta):
29:     total = 0
30:     N, M = field.shape
31:     for i in range(n - 1, n + 2):
32:         for j in range(m - 1, m + 2):
33:             if i == n and j == m:
34:                 continue
35:             total += field[clamp(i, N), clamp(j, M)]
36:     dE = 2 * field[n, m] * total
37:     if dE <= 0:
38:         field[n, m] *= -1
39:     elif np.exp(-dE * beta) > 0.5:
40:         field[n, m] *= -1

### pythran_ldpc_decoder
5: from zinnia import *
6: import numpy as np
7: from math import log, tanh
9: @zk_chip
10: def phi0(x):
11:     x = abs(x)
12:     if x < 9.08e-05:
13:         return 10
14:     else:
15:         return -log(tanh(x / 2))
17: @zk_chip
18: def G(Lq):
19:     X = sum((phi0(e) for e in Lq))
20:     s = np.prod(np.sign(Lq))
21:     return s * phi0(X)
23: @zk_chip
24: def BinaryProduct(X, Y):
25:     """ Binary Matrices or Matrix-vector product in Z/2Z. Works with scipy.sparse.csr_matrix matrices X,Y too."""
26:     A = X.dot(Y)
27:     return A % 2
29: @zk_chip
30: def InCode(H, x):
31:     """ Computes Binary Product of H and x. If product is null, x is in the code.
32:         Returns appartenance boolean. 
33:     """
34:     return (BinaryProduct(H, x) == 0).all()
36: @zk_circuit
37: @requires(lambda H, Bits, Nodes, Lq, Lc, max_iter: 0 <= max_iter <= 1024)
38: def Decoding_logBP(H: Integer[Array, '4 8'], Bits: Integer[Array, '4 4'], Nodes: Integer[Array, '8 2'], Lq: Float[Array, '4 8'], Lc: Float[Array, '8'], max_iter: Integer=1):
39:     """ Decoding function using Belief Propagation algorithm (logarithmic version)
40:     IMPORTANT: if H is large (n>1000), H should be scipy.sparse.csr_matrix object to speed up calculations
41:     (highly recommanded. )
42:     -----------------------------------
43:     Parameters:
45:     H: 2D-array (OR scipy.sparse.csr_matrix object) Parity check matrix, shape = (m,n) 
46:     y: n-vector recieved after transmission in the channel. (In general, returned 
47:     by Coding Function)
48:     Signal-Noise Ratio: SNR = 10log(1/variance) in decibels of the AWGN used in coding.
50:     max_iter: (default = 1) max iterations of the main loop. Increase if decoding is not error-free.
51:      """
52:     m, n = H.shape
53:     if not len(Lc) == n:
54:         raise ValueError('La taille de y doit correspondre au nombre de colonnes de H')
55:     if m >= n:
56:         raise ValueError('H doit avoir plus de colonnes que de lignes')
57:     Lr = np.zeros(shape=(m, n))
58:     count = 0
59:     Lq += Lc
60:     while True:
61:         count += 1
62:         for i in range(m):
63:             Ni = Bits[i]
64:             for j in Ni:
65:                 Nij = list(Ni)
66:                 Nij.remove(j)
67:                 Lr[i, j] = G(Lq[i][Nij])
68:         Lr = np.clip(Lr, -100, 100)
69:         for j in range(n):
70:             Mj = Nodes[j]
71:             for i in Mj:
72:                 Mji = list(Mj)
73:                 Mji.remove(i)
74:                 Lq[i, j] = Lc[j] + sum(Lr[Mji][:, j])
75:         extrinsic = np.empty(n)
76:         for j in range(n):
77:             Mj = Nodes[j]
78:             extrinsic[j] = sum(Lr[Mj][:, j])
79:         L_posteriori = extrinsic + Lc
80:         x = np.array(extrinsic <= 0).astype(int)
81:         product = InCode(H, x)
82:         if product or count >= max_iter:
83:             break
84:     return (np.array(L_posteriori <= 0).astype(int), Lq - Lc, extrinsic, product)

### pythran_make_circle_two_points
5: from zinnia import *
6: import math
8: @zk_chip
9: def _cross_product(x0, y0, x1, y1, x2, y2):
10:     return (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0)
12: @zk_chip
13: def make_circumcircle(a, b, c):
14:     ox = (min(a[0], b[0], c[0]) + max(a[0], b[0], c[0])) / 2.0
15:     oy = (min(a[1], b[1], c[1]) + max(a[1], b[1], c[1])) / 2.0
16:     ax = a[0] - ox
17:     ay = a[1] - oy
18:     bx = b[0] - ox
19:     by = b[1] - oy
20:     cx = c[0] - ox
21:     cy = c[1] - oy
22:     d = (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by)) * 2.0
23:     if d == 0.0:
24:         return None
25:     x = ox + ((ax * ax + ay * ay) * (by - cy) + (bx * bx + by * by) * (cy - ay) + (cx * cx + cy * cy) * (ay - by)) / d
26:     y = oy + ((ax * ax + ay * ay) * (cx - bx) + (bx * bx + by * by) * (ax - cx) + (cx * cx + cy * cy) * (bx - ax)) / d
27:     ra = math.hypot(x - a[0], y - a[1])
28:     rb = math.hypot(x - b[0], y - b[1])
29:     rc = math.hypot(x - c[0], y - c[1])
30:     return (x, y, max(ra, rb, rc))
32: @zk_chip
33: def make_diameter(a, b):
34:     cx = (a[0] + b[0]) / 2.0
35:     cy = (a[1] + b[1]) / 2.0
36:     r0 = math.hypot(cx - a[0], cy - a[1])
37:     r1 = math.hypot(cx - b[0], cy - b[1])
38:     return (cx, cy, max(r0, r1))
40: @zk_chip
41: def is_in_circle(c, p):
42:     return math.hypot(p[0] - c[0], p[1] - c[1]) <= c[2] * (1 + 1e-14)
44: @zk_chip
45: def make_circle_two_points(points, p, q):
46:     circ = make_diameter(p, q)
47:     left = None
48:     right = None
49:     px, py = p
50:     qx, qy = q
51:     for r in points:
52:         if is_in_circle(circ, r):
53:             continue
54:         cross = _cross_product(px, py, qx, qy, r[0], r[1])
55:         c = make_circumcircle(p, q, r)
56:         if c is None:
57:             continue
58:         elif cross > 0.0 and (left is None or _cross_product(px, py, qx, qy, c[0], c[1]) > _cross_product(px, py, qx, qy, left[0], left[1])):
59:             left = c
60:         elif cross < 0.0 and (right is None or _cross_product(px, py, qx, qy, c[0], c[1]) < _cross_product(px, py, qx, qy, right[0], right[1])):
61:             right = c
62:     if left is None and right is None:
63:         return circ
64:     elif left is None:
65:         return right
66:     elif right is None:
67:         return left
68:     else:
69:         return left if left[2] <= right[2] else right
71: @zk_circuit
72: def _make_circle_one_point(points: Float[Array, '3 2'], p: Tuple[Float, Float]):
73:     c = (p[0], p[1], 0.0)
74:     for i, q in enumerate(points):
75:         if not is_in_circle(c, q):
76:             if c[2] == 0.0:
77:                 c = make_diameter(p, q)
78:             else:
79:                 c = make_circle_two_points(points[:i + 1], p, q)
80:     return c

### pythran_morphology
5: from zinnia import *
6: from numpy import empty_like
8: @zk_circuit
9: @requires(lambda x, k: 0 <= k <= 1024)
10: def dilate_decompose_loops(x: Float[Array, '8 16'], k: Integer):
11:     m, n = x.shape
12:     y = empty_like(x)
13:     for i in range(m):
14:         for j in range(n):
15:             left_idx = max(0, i - k // 2)
16:             right_idx = min(m, i + k // 2 + 1)
17:             currmax = x[left_idx, j]
18:             for ii in range(left_idx + 1, right_idx):
19:                 elt = x[ii, j]
20:                 if elt > currmax:
21:                     currmax = elt
22:             y[i, j] = currmax
23:     z = empty_like(x)
24:     for i in range(m):
25:         for j in range(n):
26:             left_idx = max(0, j - k // 2)
27:             right_idx = min(n, j + k // 2 + 1)
28:             currmax = y[i, left_idx]
29:             for jj in range(left_idx + 1, right_idx):
30:                 elt = y[i, jj]
31:                 if elt > currmax:
32:                     currmax = elt
33:             z[i, j] = currmax
34:     return z

### pythran_nd_local_maxima
5: from zinnia import *
6: import numpy as np
8: @zk_chip
9: def wrap(pos, offset, bound):
10:     return (pos + offset) % bound
12: @zk_chip
13: def clamp(pos, offset, bound):
14:     return min(bound - 1, max(0, pos + offset))
16: @zk_chip
17: def reflect(pos, offset, bound):
18:     idx = pos + offset
19:     return min(2 * (bound - 1) - idx, max(idx, -idx))
21: @zk_circuit
22: def local_maxima(data: Float[Array, '8 6 4 2'], mode=wrap):
23:     wsize = data.shape
24:     result = np.ones(data.shape, bool)
25:     for pos in np.ndindex(data.shape):
26:         myval = data[pos]
27:         for offset in np.ndindex(wsize):
28:             neighbor_idx = tuple((mode(p, o - w // 2, w) for p, o, w in zip(pos, offset, wsize)))
29:             result[pos] &= data[neighbor_idx] <= myval
30:     return result

### pythran_pivot
5: from zinnia import *
7: @zk_circuit
8: @requires(lambda n, i, a, b: 0 <= n <= 1024)
9: def pivot(n: Integer, i: Integer, a: Complex[Array, '2 2'], b: Complex[Array, '2']):
10:     i0 = i
11:     amp0 = abs(a[i - 1][i - 1])
12:     for j in range(i + 1, n + 1):
13:         amp = abs(a[i - 1][j - 1])
14:         if amp > amp0:
15:             i0 = j
16:             amp0 = amp
17:     if i == i0:
18:         return
19:     temp = b[i - 1]
20:     b[i - 1] = b[i0 - 1]
21:     b[i0 - 1] = temp
22:     for j in range(i, n + 1):
23:         temp = a[j - 1][i - 1]
24:         a[j - 1][i - 1] = a[j - 1][i0 - 1]
25:         a[j - 1][i0 - 1] = temp
26:     return (a, b)

### pythran_queens_numba
5: from zinnia import *
7: @zk_chip
8: def hits(x1, y1, x2, y2):
9:     """Check whether a queen positioned at (x1, y1) will hit a queen at position (x2, y2)"""
10:     return x1 == x2 or y1 == y2 or abs(x1 - x2) == abs(y1 - y2)
12: @zk_chip
13: def hitsany(x, y, queens_x, queens_y):
14:     """Check whether a queen positioned at (x1, y1) will hit any other queen"""
15:     for i in range(len(queens_x)):
16:         if hits(x, y, queens_x[i], queens_y[i]):
17:             return True
18:     return False
20: @zk_chip
21: def _solve(n, queens_x, queens_y):
22:     """Solve the queens puzzle"""
23:     if n == 0:
24:         return True
25:     for x in range(1, 9):
26:         for y in range(1, 9):
27:             if not hitsany(x, y, queens_x, queens_y):
28:                 queens_x.append(x)
29:                 queens_y.append(y)
30:                 if _solve(n - 1, queens_x, queens_y):
31:                     return True
32:                 queens_x.pop()
33:                 queens_y.pop()
34:     return False
36: @zk_circuit
37: @requires(lambda n: 0 <= n <= 1024)
38: def solve(n: Integer):
39:     queens_x = []
40:     queens_y = []
41:     if _solve(n, queens_x, queens_y):
42:         return (queens_x, queens_y)
43:     else:
44:         return None

### pythran_shallow_water
5: from zinnia import *
6: import numpy as np
8: @zk_chip
9: def model(height, width, dtype):
10:     m = np.ones((height, width), dtype=dtype)
11:     m[height // 4, width // 4] = 6.0
12:     return m
14: @zk_chip
15: def step(H, U, V, dt=0.02, dx=1.0, dy=1.0):
16:     g = 9.80665
17:     H[:, 0] = H[:, 1]
18:     U[:, 0] = U[:, 1]
19:     V[:, 0] = -V[:, 1]
20:     H[:, -1] = H[:, -2]
21:     U[:, -1] = U[:, -2]
22:     V[:, -1] = -V[:, -2]
23:     H[0, :] = H[1, :]
24:     U[0, :] = -U[1, :]
25:     V[0, :] = V[1, :]
26:     H[-1, :] = H[-2, :]
27:     U[-1, :] = -U[-2, :]
28:     V[-1, :] = V[-2, :]
29:     Hx = (H[1:, 1:-1] + H[:-1, 1:-1]) // 2 - dt // (2 * dx) * (U[1:, 1:-1] - U[:-1, 1:-1])
30:     Ux = (U[1:, 1:-1] + U[:-1, 1:-1]) // 2 - dt / (2 * dx) * (U[1:, 1:-1] ** 2 // H[1:, 1:-1] + g // 2 * H[1:, 1:-1] ** 2 - (U[:-1, 1:-1] ** 2 // H[:-1, 1:-1] + g // 2 * H[:-1, 1:-1] ** 2))
31:     Vx = (V[1:, 1:-1] + V[:-1, 1:-1]) // 2 - dt // (2 * dx) * (U[1:, 1:-1] * V[1:, 1:-1] // H[1:, 1:-1] - U[:-1, 1:-1] * V[:-1, 1:-1] // H[:-1, 1:-1])
32:     Hy = (H[1:-1, 1:] + H[1:-1, :-1]) // 2 - dt // (2 * dy) * (V[1:-1, 1:] - V[1:-1, :-1])
33:     Uy = (U[1:-1, 1:] + U[1:-1, :-1]) // 2 - dt // (2 * dy) * (V[1:-1, 1:] * U[1:-1, 1:] // H[1:-1, 1:] - V[1:-1, :-1] * U[1:-1, :-1] // H[1:-1, :-1])
34:     Vy = (V[1:-1, 1:] + V[1:-1, :-1]) // 2 - dt // (2 * dy) * (V[1:-1, 1:] ** 2 // H[1:-1, 1:] + g // 2 * H[1:-1, 1:] ** 2 - (V[1:-1, :-1] ** 2 // H[1:-1, :-1] + g // 2 * H[1:-1, :-1] ** 2))
35:     H[1:-1, 1:-1] -= dt // dx * (Ux[1:, :] - Ux[:-1, :]) + dt // dy * (Vy[:, 1:] - Vy[:, :-1])
36:     U[1:-1, 1:-1] -= dt // dx * (Ux[1:, :] ** 2 // Hx[1:, :] + g // 2 * Hx[1:, :] ** 2 - (Ux[:-1, :] ** 2 // Hx[:-1, :] + g // 2 * Hx[:-1, :] ** 2)) + dt // dy * (Vy[:, 1:] * Uy[:, 1:] // Hy[:, 1:] - Vy[:, :-1] * Uy[:, :-1] // Hy[:, :-1])
37:     V[1:-1, 1:-1] -= dt // dx * (Ux[1:, :] * Vx[1:, :] // Hx[1:, :] - Ux[:-1, :] * Vx[:-1, :] // Hx[:-1, :]) + dt // dy * (Vy[:, 1:] ** 2 // Hy[:, 1:] + g // 2 * Hy[:, 1:] ** 2 - (Vy[:, :-1] ** 2 // Hy[:, :-1] + g // 2 * Hy[:, :-1] ** 2))
38:     return (H, U, V)
40: @zk_chip
41: def simulate(H, timesteps):
42:     U = np.zeros_like(H)
43:     V = np.zeros_like(H)
44:     for i in range(timesteps):
45:         H, U, V = step(H, U, V)
46:     return H
48: @zk_circuit
49: def run(H: Integer, W: Integer, I: Integer):
50:     m = model(H, W, dtype=np.float64)
51:     m = simulate(m, I)
52:     return m

### pythran_spectraldns
5: from zinnia import *
7: @zk_chip
8: def cross1(c, a, b):
9:     c[0] = a[0] * b[2] - a[2] * b[1]
10:     c[1] = a[2] * b[0] - a[0] * b[2]
11:     c[2] = a[0] * b[1] - a[1] * b[0]
12:     return c
14: @zk_circuit
15: def cross2(c: Complex[Array, '3 2 5 7'], a: Float[Array, '3 2 5 7'], b: Complex[Array, '3 2 5 7']):
16:     cross1(c, a, b)
17:     c *= 1j
18:     return c
20: @zk_circuit
21: def add_pressure_diffusion(dU: Complex[Array, '3 2 5 7'], U_hat: Complex[Array, '3 2 5 7'], K2: Float[Array, '2 5 7'], K: Float[Array, '3 2 5 7'], P_hat: Complex[Array, '2 5 7'], K_over_K2: Float[Array, '3 2 5 7'], nu: Float):
22:     du0, du1, du2 = (dU[0], dU[1], dU[2])
23:     k_0, k_1, k_2 = (K_over_K2[0], K_over_K2[1], K_over_K2[2])
24:     P_hat[:] = du0 * k_0 + du1 * k_1 + du2 * k_2
25:     dU[:] = dU - P_hat * K - nu * K2 * U_hat
26:     return P_hat

### pythran_train_eq
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def train_eq(E: Complex[Array, '1 16'], TrSyms: Integer, os: Integer, mu: Float, wx: Complex[Array, '1 10'], errfctprs: Tuple[Complex, Complex[Array, '4']], adapt: Boolean):
10:     Ntaps = wx.shape[1]
11:     pols = wx.shape[0]
12:     R, symbs = errfctprs
13:     err = np.zeros(TrSyms, dtype=E.dtype)
14:     for i in range(TrSyms):
15:         X = E[:, i * os:i * os + Ntaps]
16:         Xest = np.sum(np.conj(wx) * X)
17:         err[i] = (R.real - abs(Xest) ** 2) * Xest
18:         wx += mu * np.conj(err[i]) * X
19:         if adapt and i > 0:
20:             if err[i].real * err[i - 1].real > 0 and err[i].imag * err[i - 1].imag > 0:
21:                 pass
22:             else:
23:                 mu = np.float32(mu / (1 + mu * (err[i].real * err[i].real + err[i].imag * err[i].imag)))
24:     return (err, wx, mu)
26: @zk_circuit
27: def train_eq2(E: Complex[Array, '1 16'], TrSyms: Integer, os: Integer, mu: Float, wx: Complex[Array, '1 10'], errfctprs: Tuple[Complex, Complex[Array, '4']], adapt: Boolean):
28:     Ntaps = wx.shape[1]
29:     pols = wx.shape[0]
30:     R, symbs = errfctprs
31:     err = np.zeros(TrSyms, dtype=E.dtype)
32:     for i in range(TrSyms):
33:         X = E[:, i * os:i * os + Ntaps]
34:         Xest = np.sum(np.conj(wx) * X)
35:         err[i] = (R.real - abs(Xest) ** 2) * Xest
36:         wx += mu * np.conj(err[i]) * X
37:         if adapt and i > 0:
38:             if err[i].real * err[i - 1].real > 0 and err[i].imag * err[i - 1].imag > 0:
39:                 pass
40:             else:
41:                 mu = np.float32(mu / (1 + mu * (err[i].real * err[i].real + err[i].imag * err[i].imag)))
42:     return (err, wx, mu)
44: @zk_chip
45: def cma_error(Xest, R, symbs):
