5: from zinnia import *
6: import numpy as np
8: @zk_chip
9: def m2f_loc(m, f):
10:     c0 = 1.0 / 6
11:     c1 = 1.0 / 9
12:     c2 = 1.0 / 18
13:     c3 = 1.0 / 36
14:     c4 = 1.0 / 12
15:     f[0] = c1 * m[0] - c1 * m[3] + c1 * m[4]
16:     f[1] = c1 * m[0] + c0 * m[1] - c3 * m[3] - c2 * m[4] - c0 * m[5] + 0.25 * m[7]
17:     f[2] = c1 * m[0] + c0 * m[2] - c3 * m[3] - c2 * m[4] - c0 * m[6] - 0.25 * m[7]
18:     f[3] = c1 * m[0] - c0 * m[1] - c3 * m[3] - c2 * m[4] + c0 * m[5] + 0.25 * m[7]
19:     f[4] = c1 * m[0] - c0 * m[2] - c3 * m[3] - c2 * m[4] + c0 * m[6] - 0.25 * m[7]
20:     f[5] = c1 * m[0] + c0 * m[1] + c0 * m[2] + c2 * m[3] + c3 * m[4] + c4 * m[5] + c4 * m[6] + 0.25 * m[8]
21:     f[6] = c1 * m[0] - c0 * m[1] + c0 * m[2] + c2 * m[3] + c3 * m[4] - c4 * m[5] + c4 * m[6] - 0.25 * m[8]
22:     f[7] = c1 * m[0] - c0 * m[1] - c0 * m[2] + c2 * m[3] + c3 * m[4] - c4 * m[5] - c4 * m[6] + 0.25 * m[8]
23:     f[8] = c1 * m[0] + c0 * m[1] - c0 * m[2] + c2 * m[3] + c3 * m[4] + c4 * m[5] - c4 * m[6] - 0.25 * m[8]
25: @zk_chip
26: def f2m_loc(f, m):
27:     m[0] = f[0] + f[1] + f[2] + f[3] + f[4] + f[5] + f[6] + f[7] + f[8]
28:     m[1] = f[1] - f[3] + f[5] - f[6] - f[7] + f[8]
29:     m[2] = f[2] - f[4] + f[5] + f[6] - f[7] - f[8]
30:     m[3] = -4.0 * f[0] - f[1] - f[2] - f[3] - f[4] + 2.0 * f[5] + 2.0 * f[6] + 2.0 * f[7] + 2.0 * f[8]
31:     m[4] = 4.0 * f[0] - 2.0 * f[1] - 2.0 * f[2] - 2.0 * f[3] - 2.0 * f[4] + f[5] + f[6] + f[7] + f[8]
32:     m[5] = -2.0 * f[1] + 2.0 * f[3] + f[5] - f[6] - f[7] + f[8]
33:     m[6] = -2.0 * f[2] + 2.0 * f[4] + f[5] + f[6] - f[7] - f[8]
34:     m[7] = f[1] - f[2] + f[3] - f[4]
35:     m[8] = f[5] - f[6] + f[7] - f[8]
37: @zk_chip
38: def getf(f, floc, i, j):
39:     floc[0] = f[i, j, 0]
40:     floc[1] = f[i - 1, j, 1]
41:     floc[2] = f[i, j - 1, 2]
42:     floc[3] = f[i + 1, j, 3]
43:     floc[4] = f[i, j + 1, 4]
44:     floc[5] = f[i - 1, j - 1, 5]
45:     floc[6] = f[i + 1, j - 1, 6]
46:     floc[7] = f[i + 1, j + 1, 7]
47:     floc[8] = f[i - 1, j + 1, 8]
49: @zk_chip
50: def setf(f, floc, i, j):
51:     f[j, i, 0] = floc[0]
52:     f[j, i, 1] = floc[1]
53:     f[j, i, 2] = floc[2]
54:     f[j, i, 3] = floc[3]
55:     f[j, i, 4] = floc[4]
56:     f[j, i, 5] = floc[5]
57:     f[j, i, 6] = floc[6]
58:     f[j, i, 7] = floc[7]
59:     f[j, i, 8] = floc[8]
61: @zk_chip
62: def relaxation_loc(m):
63:     m[3] += 1.1312217194570136 * (-2 * m[0] + 3.0 * m[1] * m[1] + 3.0 * m[2] * m[2] - m[3])
64:     m[4] += 1.1312217194570136 * (m[0] + 1.5 * m[1] * m[1] + 1.5 * m[2] * m[2] - m[4])
65:     m[5] += 1.1312217194570136 * (-m[1] - m[5])
66:     m[6] += 1.1312217194570136 * (-m[2] - m[6])
67:     m[7] += 1.8573551263001487 * (m[1] * m[1] - m[2] * m[2] - m[7])
68:     m[8] += 1.8573551263001487 * (m[1] * m[2] - m[8])
70: @zk_chip
71: def periodic_bc(f):
72:     nx, ny, ns = f.shape
73:     for j in range(ny):
74:         for k in range(ns):
75:             f[0, j, k] = f[nx - 2, j, k]
76:             f[nx - 1, j, k] = f[1, j, k]
77:     for i in range(nx):
78:         for k in range(ns):
79:             f[i, 0, k] = f[i, ny - 2, k]
80:             f[i, ny - 1, k] = f[i, 1, k]
82: @zk_circuit
83: def one_time_step(f1: Float[Array, '16 16 9'], f2: Float[Array, '16 16 9']):
84:     nx, ny, ns = f1.shape
85:     floc = np.zeros(ns)
86:     mloc = np.zeros(ns)
87:     periodic_bc(f1)
88:     for i in range(1, nx - 1):
89:         for j in range(1, ny - 1):
90:             getf(f1, floc, i, j)
91:             f2m_loc(floc, mloc)
92:             relaxation_loc(mloc)
93:             m2f_loc(mloc, floc)
94:             setf(f2, floc, i, j)
95:     return f2

### pythran_euler_challenge14
5: from zinnia import *
7: @zk_chip
8: def next_num(num):
9:     if num & 1:
10:         return 3 * num + 1
11:     else:
12:         return num // 2
14: @zk_chip
15: def series_length(num, lengths):
16:     if num in lengths:
17:         return lengths[num]
18:     else:
19:         num2 = next_num(num)
20:         result = 1 + series_length(num2, lengths)
21:         lengths[num] = result
22:         return result
24: @zk_circuit
25: def euler14(MAX_NUM: Integer):
26:     num_with_max_length = 1
27:     max_length = 0
28:     lengths = {1: 0}
29:     for ii in range(1, MAX_NUM):
30:         length = series_length(ii, lengths)
31:         if length > max_length:
32:             max_length = length
33:             num_with_max_length = ii
34:     return (num_with_max_length, max_length)

### pythran_fibo
