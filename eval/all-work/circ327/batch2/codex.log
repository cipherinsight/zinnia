    floc = np.zeros(ns)
    mloc = np.zeros(ns)
    periodic_bc(f1)
    for i in range(1, nx - 1):
        for j in range(1, ny - 1):
            getf(f1, floc, i, j)
            f2m_loc(floc, mloc)
            relaxation_loc(mloc)
            m2f_loc(mloc, floc)
            setf(f2, floc, i, j)
    return f2

