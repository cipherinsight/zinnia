### npbench_mandelbrot1_mandelbrot1
5: from zinnia import *
6: import numpy as np
8: @zk_circuit
9: def mandelbrot(xmin: Float, xmax: Float, ymin: Float, ymax: Float, xn: Integer, yn: Integer, maxiter: Integer, horizon: Float=2.0):
10:     X = np.linspace(xmin, xmax, xn, dtype=np.float64)
11:     Y = np.linspace(ymin, ymax, yn, dtype=np.float64)
12:     C = X + Y[:, None] * 1j
13:     N = np.zeros(C.shape, dtype=np.int64)
14:     Z = np.zeros(C.shape, dtype=np.complex128)
15:     for n in range(maxiter):
16:         I = np.less(abs(Z), horizon)
17:         N[I] = n
18:         Z[I] = Z[I] ** 2 + C[I]
19:     N[N == maxiter - 1] = 0
20:     return (Z, N)

