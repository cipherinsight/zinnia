### pythran_cdotc
5: from zinnia import *
7: @zk_circuit
8: @requires(lambda N, CX, INCX, CY, INCY: 0 <= N <= 1024)
9: def CDOTC(N: Integer, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
10:     CTEMP = complex(0.0, 0.0)
11:     CDOTC = complex(0.0, 0.0)
12:     if N <= 0:
13:         return
14:     if INCX == 1 and INCY == 1:
15:         for I in range(N):
16:             CTEMP = CTEMP + CX[I].conjugate() * CY[I]
17:     else:
18:         IX = 0
19:         IY = 0
20:         if INCX < 0:
21:             IX = (-N + 1) * INCX
22:         if INCY < 0:
23:             IY = (-N + 1) * INCY
24:         for I in range(N):
25:             CTEMP = CTEMP + CX[IX].conjugate() * CY[IY]
26:             IX = IX + INCX
27:             IY = IY + INCY
28:     return CTEMP

