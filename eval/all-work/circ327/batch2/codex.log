from zinnia import *

@zk_circuit
def is_square(a_positive_int: Integer):
    """ Check if it is a perfect square. """
    x = a_positive_int // 2
    seen = {x}
    while x * x != a_positive_int:
        x = (x + a_positive_int // x) // 2
        if x in seen:
            return False
        seen.add(x)
    return True

