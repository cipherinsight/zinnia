from "EMBED" import int_to_bits, u32_from_bits, field_to_integer, u32_to_field

def ui(integer x) -> u32:
    return u32_from_bits(int_to_bits::<32>(x))

def it(u32 x) -> integer:
    return field_to_integer(u32_to_field(x))

def mul(integer x, integer y) -> integer:
    return (x*y)/4294967296

def main(private integer[5][4] X) -> integer[5][4]:
    integer[5] linf = [0; 5]
    for u32 i in 0..5 do
        for u32 j in 0..4 do
            integer v = if X[i][j] < 0 then -X[i][j] else X[i][j] fi
            linf[i] = if v > linf[i] then v else linf[i] fi
        endfor
    endfor
    integer[5][4] result = [[0; 4]; 5]
    for u32 i in 0..5 do
        for u32 j in 0..4 do
            result[i][j] = (X[i][j]*4294967296)/linf[i]
        endfor
    endfor
    return result
