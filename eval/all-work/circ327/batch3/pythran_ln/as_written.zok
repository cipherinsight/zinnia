// benchmarking/datasets/pythran/pythran_ln/kernel.py
// Signed integers use their canonical field residues; real inputs are Q32.
def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256
def absv(field x) -> field:
    return if neg(x) then -x else x fi
def lt(field a, field b) -> bool:
    return if neg(a) != neg(b) then neg(a) else a < b fi
// Constant integer rescaling uses native remainder and field division only.
def divc(field x, field c) -> field:
    field m = absv(x)
    field q = (m - m % c) / c
    return if neg(x) then -q else q fi
def mulq(field a, field b) -> field:
    return divc(a * b, 4294967296)

def main(private field[16] X, private field[16] Y) -> field[16]:
    for u32 i in 0..16 do
        field z = X[i] - 4294967296
        field acc = z
        acc = acc - divc(mulq(z, z), 2)
        acc = acc + divc(mulq(mulq(z, z), z), 3)
        acc = acc - divc(mulq(mulq(mulq(z, z), z), z), 4)
        acc = acc + divc(mulq(mulq(mulq(mulq(z, z), z), z), z), 5)
        acc = acc - divc(mulq(mulq(mulq(mulq(mulq(z, z), z), z), z), z), 6)
        acc = acc + divc(mulq(mulq(mulq(mulq(mulq(mulq(z, z), z), z), z), z), z), 7)
        acc = acc - divc(mulq(mulq(mulq(mulq(mulq(mulq(mulq(z, z), z), z), z), z), z), z), 8)
        acc = acc + divc(mulq(mulq(mulq(mulq(mulq(mulq(mulq(mulq(z, z), z), z), z), z), z), z), z), 9)
        Y[i] = acc
    endfor
    return Y
