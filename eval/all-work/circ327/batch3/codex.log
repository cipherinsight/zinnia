### pythran_blacksholes
4: 
5: from zinnia import *
6: import math
7: 
8: @zk_circuit
9: @requires(lambda stock_price, option_strike, option_years, Riskfree, Volatility, nb_opt: Volatility != 0.0)
10: @requires(lambda stock_price, option_strike, option_years, Riskfree, Volatility, nb_opt: 0 <= nb_opt <= 1024)
11: def BlackScholes(stock_price: Integer[Array, '14'], option_strike: Integer[Array, '14'], option_years: Integer[Array, '14'], Riskfree: Float, Volatility: Float, nb_opt: Integer):
12:     RSQRT2PI = 1 / math.sqrt(math.pi * 2)
13:     A1 = 0.31938153
14:     A2 = -0.356563782
15:     A3 = 1.781477937
16:     A4 = -1.821255978
17:     A5 = 1.330274429
18:     call_result = []
19:     put_result = []
20:     for opt in range(0, nb_opt):
21:         sqrtT = math.sqrt(option_years[opt])
22:         d1 = math.log(stock_price[opt] / option_strike[opt])
23:         d1 += (Riskfree + 0.5 * Volatility * Volatility) * option_years[opt]
24:         d1 /= Volatility * sqrtT
25:         d2 = d1 - Volatility * sqrtT
26:         K = 1.0 / (1.0 + 0.2316419 * abs(d1))
27:         CNDD1 = RSQRT2PI * math.exp(-0.5 * d1 * d1) * (K * (A1 + K * (A2 + K * (A3 + K * (A4 + K * A5)))))
28:         K = 1.0 / (1.0 + 0.2316419 * abs(d2))
29:         CNDD2 = RSQRT2PI * math.exp(-0.5 * d2 * d2) * (K * (A1 + K * (A2 + K * (A3 + K * (A4 + K * A5)))))
30:         expRT = math.exp(-Riskfree * option_years[opt])
31:         call_result.append(stock_price[opt] * CNDD1 - option_strike[opt] * expRT * CNDD2)
32:         put_result.append(option_strike[opt] * expRT * (1.0 - CNDD2) - stock_price[opt] * (1.0 - CNDD1))
33:     return (call_result, put_result)


### pythran_cdotu
4: 
5: from zinnia import *
6: 
7: @zk_circuit
8: @requires(lambda N, CX, INCX, CY, INCY: 0 <= N <= 1024)
9: def CDOTU(N: Integer, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
10:     CTEMP = complex(0.0, 0.0)
11:     CDOTU = complex(0.0, 0.0)
12:     if N <= 0:
13:         return
14:     if INCX == 1 and INCY == 1:
15:         for I in range(N):
16:             CTEMP = CTEMP + CX[I] * CY[I]
17:     else:
18:         IX = 0
19:         IY = 0
20:         if INCX < 0:
21:             IX = (-N + 1) * INCX
22:         if INCY < 0:
23:             IY = (-N + 1) * INCY
24:         for I in range(N):
25:             CTEMP = CTEMP + CX[IX] * CY[IY]
26:             IX = IX + INCX
27:             IY = IY + INCY
28:     return CTEMP


### pythran_compute_subpix_2d_gaussian2
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: def compute_subpix_2d_gaussian2(correl: Float[Array, '4 4'], ix: Integer, iy: Integer):
10:     correl_crop = correl[iy - 1:iy + 2, ix - 1:ix + 2]
11:     tmp = np.where(correl_crop < 0)
12:     for i0, i1 in zip(tmp[0], tmp[1]):
13:         correl_crop[i0, i1] = 1e-06
14:     c10 = 0
15:     c01 = 0
16:     c11 = 0
17:     c20 = 0
18:     c02 = 0
19:     for i in range(1):
20:         for j in range(1):
21:             c10 += (i - 1) * np.log(correl_crop[j, i])
22:             c01 += (j - 1) * np.log(correl_crop[j, i])
23:             c11 += (i - 1) * (j - 1) * np.log(correl_crop[j, i])
24:             c20 += (3 * (i - 1) ** 2 - 2) * np.log(correl_crop[j, i])
25:             c02 += (3 * (j - 1) ** 2 - 2) * np.log(correl_crop[j, i])
26:             c00 = (5 - 3 * (i - 1) ** 2 - 3 * (j - 1) ** 2) * np.log(correl_crop[j, i])
27:     c00, c10, c01, c11, c20, c02 = (c00 / 9, c10 / 6, c01 / 6, c11 / 4, c20 / 6, c02 / 6)
28:     deplx = np.float32((c11 * c01 - 2 * c10 * c02) / (4 * c20 * c02 - c11 ** 2))
29:     deply = np.float32((c11 * c10 - 2 * c01 * c20) / (4 * c20 * c02 - c11 ** 2))
30:     return (deplx, deply, correl_crop)


### pythran_deriv
4: 
5: from zinnia import *
6: 
7: @zk_circuit
8: @requires(lambda n, sig, alp, dg, dh1, dh3, bin, nu: 0 <= n <= 1024)
9: def deriv(n: Integer, sig: Float, alp: Complex, dg: Complex[Array, '4'], dh1: Complex[Array, '4'], dh3: Complex[Array, '4'], bin: Complex[Array, '5 4'], nu: Float):
10:     dh2 = [complex(0, 0) for _ in dh1]
11:     ci = complex(0.0, 1.0)
12:     dh1[0] = complex(0.5, 0) * ci * complex(sig, 0)
13:     exp1 = complex(-0.5, 0)
14:     dh2[0] = alp
15:     exp2 = complex(-1.0, 0)
16:     dh3[0] = -2.0 * nu
17:     exp3 = complex(-1.0, 0)
18:     for i in range(1, n):
19:         dh1[i] = dh1[i - 1] * exp1
20:         exp1 = exp1 - 1.0
21:         dh2[i] = dh2[i - 1] * exp2
22:         exp2 = exp2 - 1.0
23:         dh3[i] = -nu * dh3[i - 1] * exp3
24:         exp3 = exp3 - 1.0
25:     dg[0] = complex(1.0)
26:     dg[1] = dh1[0] + dh2[0] + dh3[0]
27:     for i in range(2, n + 1):
28:         dg[i] = dh1[i - 1] + dh2[i - 1] + dh3[i - 1]
29:         for j in range(1, i):
30:             dg[i] = dg[i] + bin[j - 1][i - 1] * (dh1[j - 1] + dh2[j - 1] + dh3[j - 1]) * dg[i - j]
31:     return dg


### pythran_factorize_naive
4: 
5: from zinnia import *
6: 
7: @zk_circuit
8: @requires(lambda n: 0 <= n <= 1024)
9: def factorize_naive(n: Integer):
10:     """ A naive factorization method. Take integer 'n', return list of
11:         factors.
12:     """
13:     if n < 2:
14:         return []
15:     factors = []
16:     p = 2
17:     while True:
18:         if n == 1:
19:             return factors
20:         r = n % p
21:         if r == 0:
22:             factors.append(p)
23:             n = n / p
24:         elif p * p >= n:
25:             factors.append(n)
26:             return factors
27:         elif p > 2:
28:             p += 2
29:         else:
30:             p += 1
31:     assert False, 'unreachable'


