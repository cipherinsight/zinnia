### pythran_harris
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: def harris(I: Float[Array, '4 6']):
10:     m, n = I.shape
11:     dx = (I[1:, :] - I[:m - 1, :])[:, 1:]
12:     dy = (I[:, 1:] - I[:, :n - 1])[1:, :]
13:     A = dx * dx
14:     B = dy * dy
15:     C = dx * dy
16:     tr = A + B
17:     det = A * B - C * C
18:     k = 0.05
19:     return det - k * tr * tr


