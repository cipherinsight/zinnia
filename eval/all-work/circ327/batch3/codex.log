from zinnia import *

@zk_circuit
@requires(lambda n: 0 <= n <= 1024)
def fibo(n: Integer):
    """ fibonaccie compuation. """
    a, b = (1, 1)
    for _ in range(n):
        a, b = (a + b, a)
    return a

