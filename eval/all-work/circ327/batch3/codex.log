        X = 0.75
        for I in range(1, N11 + 1):
            X = DSQRT(DEXP(DLOG(X) / T1))
        JJ += 1
    KIP = 100.0 * LOOP * II
    return KIP

@zk_chip
def PA(E, T, T2):
    J = 0
    while J < 6:
        E[0] = (E[0] + E[1] + E[2] - E[3]) * T
        E[1] = (E[0] + E[1] - E[2] + E[3]) * T
        E[2] = (E[0] - E[1] + E[2] + E[3]) * T
        E[3] = (-E[0] + E[1] + E[2] + E[3]) / T2
        J += 1

@zk_chip
def P0(E1, J, K, L):
    E1[J - 1] = E1[K - 1]
    E1[K - 1] = E1[L - 1]
    E1[L - 1] = E1[J - 1]

@zk_chip
def P3(X, Y, T, T2):
    X1 = X
    Y1 = Y
    X1 = T * (X1 + Y1)
    Y1 = T * (X1 + Y1)
    return (X1 + Y1) / T2

