### pythran_quicksort
4: 
5: from zinnia import *
6: 
7: @zk_chip
8: def partition(list, start, end):
9:     pivot = list[end]
10:     bottom = start - 1
11:     top = end
12:     done = 0
13:     while not done:
14:         while not done:
15:             bottom = bottom + 1
16:             if bottom == top:
17:                 done = 1
18:                 break
19:             if list[bottom] > pivot:
20:                 list[top] = list[bottom]
21:                 break
22:         while not done:
23:             top = top - 1
24:             if top == bottom:
25:                 done = 1
26:                 break
27:             if list[top] < pivot:
28:                 list[bottom] = list[top]
29:                 break
30:     list[top] = pivot
31:     return top
32: 
33: @zk_chip
34: def do_quicksort(list, start, end):
35:     if start < end:
36:         split = partition(list, start, end)
37:         do_quicksort(list, start, split - 1)
38:         do_quicksort(list, split + 1, end)
39: 
40: @zk_circuit
41: def quicksort(l: Integer[Array, '10'], s: Integer, e: Integer):
42:     do_quicksort(l, s, e)


### pythran_slowparts
4: 
5: from zinnia import *
6: from numpy import zeros, power, tanh
7: 
8: @zk_circuit
9: def slowparts(d: Integer, re: Integer, preDz: Float[Array, '16 9 5'], preWz: Float[Array, '8 9 5'], SRW: Float[Array, '8 16'], RSW: Float[Array, '8 16'], yxV: Float[Array, '9 5 8'], xyU: Float[Array, '9 5 8'], resid: Integer):
10:     """ computes the linear algebra intensive part of the gradients of the grae
11:     """
12:     fprime = lambda x: 1 - power(tanh(x), 2)
13:     partialDU = zeros((d + 1, re, 2 * d, d))
14:     for k in range(2 * d):
15:         for i in range(d):
16:             partialDU[:, :, k, i] = fprime(preDz[k]) * fprime(preWz[i]) * (SRW[i, k] + RSW[i, k]) * yxV[:, :, i]
17:     return partialDU


### pythran_stone
4: 
5: from zinnia import *
6: from math import sin as DSIN, cos as DCOS, atan as DATAN, log as DLOG, exp as DEXP, sqrt as DSQRT
7: 
8: @zk_circuit
9: def whetstone(loopstart: Integer):
10:     T = 0.499975
11:     T1 = 0.50025
12:     T2 = 2.0
13:     LOOP = loopstart
14:     II = 1
15:     JJ = 1
16:     while JJ <= II:
17:         N1 = 0
18:         N2 = 12 * LOOP
19:         N3 = 14 * LOOP
20:         N4 = 345 * LOOP
21:         N6 = 210 * LOOP
22:         N7 = 32 * LOOP
23:         N8 = 899 * LOOP
24:         N9 = 616 * LOOP
25:         N10 = 0
26:         N11 = 93 * LOOP
27:         X1 = 1.0
28:         X2 = -1.0
29:         X3 = -1.0
30:         X4 = -1.0
31:         for I in range(1, N1 + 1):
32:             X1 = (X1 + X2 + X3 - X4) * T
33:             X2 = (X1 + X2 - X3 + X4) * T
34:             X3 = (X1 - X2 + X3 + X4) * T
35:             X4 = (-X1 + X2 + X3 + X4) * T
36:         E1 = [1.0, -1.0, -1.0, -1.0]
37:         for I in range(1, N2 + 1):
38:             E1[0] = (E1[0] + E1[1] + E1[2] - E1[3]) * T
39:             E1[1] = (E1[0] + E1[1] - E1[2] + E1[3]) * T
40:             E1[2] = (E1[0] - E1[1] + E1[2] + E1[3]) * T
41:             E1[3] = (-E1[0] + E1[1] + E1[2] + E1[3]) * T
42:         for I in range(1, N3 + 1):
43:             PA(E1, T, T2)
44:         J = 1
45:         for I in range(1, N4 + 1):
46:             if J == 1:
47:                 J = 2
48:             else:
49:                 J = 3
50:             if J > 2:
51:                 J = 0
52:             else:
53:                 J = 1
54:             if J < 1:
55:                 J = 1
56:             else:
57:                 J = 0
58:         J = 1
59:         K = 2
60:         L = 3
61:         for I in range(1, N6 + 1):
62:             J = J * (K - J) * (L - K)
63:             K = L * K - (L - J) * K
64:             L = (L - K) * (K + J)
65:             E1[L - 2] = J + K + L
66:             E1[K - 2] = J * K * L
67:         X = 0.5
68:         Y = 0.5
69:         for I in range(1, N7 + 1):
70:             X = T * DATAN(T2 * DSIN(X) * DCOS(X) / (DCOS(X + Y) + DCOS(X - Y) - 1.0))
71:             Y = T * DATAN(T2 * DSIN(Y) * DCOS(Y) / (DCOS(X + Y) + DCOS(X - Y) - 1.0))
72:         X = 1.0
73:         Y = 1.0
74:         Z = 1.0
75:         for I in range(1, N8 + 1):
76:             Z = P3(X, Y, T, T2)
77:         J = 1
78:         K = 2
79:         L = 3
80:         E1[0] = 1.0
81:         E1[1] = 2.0
82:         E1[2] = 3.0
83:         for I in range(1, N9 + 1):
84:             P0(E1, J, K, L)
85:         J = 2
86:         K = 3
87:         for I in range(1, N10 + 1):
88:             J = J + K
89:             K = J + K
90:             J = K - J
91:             K = K - J - J
92:         X = 0.75
93:         for I in range(1, N11 + 1):
94:             X = DSQRT(DEXP(DLOG(X) / T1))
95:         JJ += 1
96:     KIP = 100.0 * LOOP * II
97:     return KIP
98: 
99: @zk_chip
100: def PA(E, T, T2):
101:     J = 0
102:     while J < 6:
103:         E[0] = (E[0] + E[1] + E[2] - E[3]) * T
104:         E[1] = (E[0] + E[1] - E[2] + E[3]) * T
105:         E[2] = (E[0] - E[1] + E[2] + E[3]) * T
106:         E[3] = (-E[0] + E[1] + E[2] + E[3]) / T2
107:         J += 1
108: 
109: @zk_chip
110: def P0(E1, J, K, L):
111:     E1[J - 1] = E1[K - 1]
112:     E1[K - 1] = E1[L - 1]
113:     E1[L - 1] = E1[J - 1]
114: 
115: @zk_chip
116: def P3(X, Y, T, T2):
117:     X1 = X
118:     Y1 = Y
119:     X1 = T * (X1 + Y1)
120:     Y1 = T * (X1 + Y1)
121:     return (X1 + Y1) / T2


