### pythran_nqueens
4: 
5: from zinnia import *
6: 
7: @zk_chip
8: def permutations(iterable, r=None):
9:     """permutations(range(3), 2) --> (0,1) (0,2) (1,0) (1,2) (2,0) (2,1)"""
10:     pool = tuple(iterable)
11:     n = len(pool)
12:     if r is None:
13:         r = n
14:     indices = list(range(n))
15:     cycles = list(range(n - r + 1, n + 1))[::-1]
16:     yield tuple((pool[i] for i in indices[:r]))
17:     while n:
18:         for i in reversed(range(r)):
19:             cycles[i] -= 1
20:             if cycles[i] == 0:
21:                 indices[i:] = indices[i + 1:] + indices[i:i + 1]
22:                 cycles[i] = n - i
23:             else:
24:                 j = cycles[i]
25:                 indices[i], indices[-j] = (indices[-j], indices[i])
26:                 yield tuple((pool[i] for i in indices[:r]))
27:                 break
28:         else:
29:             return
30: 
31: @zk_circuit
32: def n_queens(queen_count: Integer):
33:     """N-Queens solver.
34: 
35:     Args:
36:         queen_count: the number of queens to solve for. This is also the
37:             board size.
38: 
39:     Yields:
40:         Solutions to the problem. Each yielded value is looks like
41:         (3, 8, 2, 1, 4, ..., 6) where each number is the column position for the
42:         queen, and the index into the tuple indicates the row.
43:     """
44:     out = list()
45:     cols = list(range(queen_count))
46:     for vec in permutations(cols, None):
47:         if queen_count == len(set((vec[i] + i for i in cols))) == len(set((vec[i] - i for i in cols))):
48:             out.append(vec)
49:     return out


