8: @zk_chip
9: def relu(x):
10:     return np.maximum(x, 0)
11: 
12: @zk_chip
13: def conv2d(input, weights):
14:     K = weights.shape[0]
15:     N = input.shape[0]
16:     H_out = input.shape[1] - K + 1
17:     W_out = input.shape[2] - K + 1
18:     C_out = weights.shape[3]
19:     output = np.empty((N, H_out, W_out, C_out), dtype=np.float32)
20:     for i in range(H_out):
21:         for j in range(W_out):
22:             output[:, i, j, :] = np.sum(input[:, i:i + K, j:j + K, :, np.newaxis] * weights[np.newaxis, :, :, :], axis=(1, 2, 3))
23:     return output
24: 
25: @zk_chip
26: def maxpool2d(x):
27:     output = np.empty([x.shape[0], x.shape[1] // 2, x.shape[2] // 2, x.shape[3]], dtype=x.dtype)
28:     for i in range(x.shape[1] // 2):
29:         for j in range(x.shape[2] // 2):
30:             output[:, i, j, :] = np.max(x[:, 2 * i:2 * i + 2, 2 * j:2 * j + 2, :], axis=(1, 2))
31:     return output
32: 
33: @zk_circuit
34: def lenet5(input: Float[Array, '2 16 16 1'], conv1: Float[Array, '5 5 1 6'], conv1bias: Float[Array, '6'], conv2: Float[Array, '5 5 6 16'], conv2bias: Float[Array, '16'], fc1w: Float[Array, '16 120'], fc1b: Float[Array, '120'], fc2w: Float[Array, '120 84'], fc2b: Float[Array, '84'], fc3w: Float[Array, '84 10'], fc3b: Float[Array, '10'], N: Integer, C_before_fc1: Integer):
35:     x = relu(conv2d(input, conv1) + conv1bias)
36:     x = maxpool2d(x)
37:     x = relu(conv2d(x, conv2) + conv2bias)
38:     x = maxpool2d(x)
39:     x = np.reshape(x, (N, C_before_fc1))
40:     x = relu(x @ fc1w + fc1b)
41:     x = relu(x @ fc2w + fc2b)
42:     return x @ fc3w + fc3b


### npbench_mandelbrot2_mandelbrot2
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: @requires(lambda xmin, xmax, ymin, ymax, xn, yn, itermax, horizon: 0 <= itermax <= 1024)
10: def mandelbrot(xmin: Float, xmax: Float, ymin: Float, ymax: Float, xn: Integer, yn: Integer, itermax: Integer, horizon: Float=2.0):
11:     Xi, Yi = np.mgrid[0:xn, 0:yn]
12:     X = np.linspace(xmin, xmax, xn, dtype=np.float64)[Xi]
13:     Y = np.linspace(ymin, ymax, yn, dtype=np.float64)[Yi]
14:     C = X + Y * 1j
15:     N_ = np.zeros(C.shape, dtype=np.int64)
16:     Z_ = np.zeros(C.shape, dtype=np.complex128)
17:     Xi.shape = Yi.shape = C.shape = xn * yn
18:     Z = np.zeros(C.shape, np.complex128)
19:     for i in range(itermax):
20:         if not len(Z):
21:             break
22:         np.multiply(Z, Z, Z)
23:         np.add(Z, C, Z)
24:         I = abs(Z) > horizon
25:         N_[Xi[I], Yi[I]] = i + 1
26:         Z_[Xi[I], Yi[I]] = Z[I]
27:         np.logical_not(I, I)
28:         Z = Z[I]
29:         Xi, Yi = (Xi[I], Yi[I])
30:         C = C[I]
31:     return (Z_.T, N_.T)


