// benchmarking/datasets/ds1000_numpy/generated/case0468/kernel.py
// Signed integers use their canonical field residues; real inputs are Q32.
def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256
def absv(field x) -> field:
    return if neg(x) then -x else x fi
def lt(field a, field b) -> bool:
    return if neg(a) != neg(b) then neg(a) else a < b fi
// Constant integer rescaling uses native remainder and field division only.
def divc(field x, field c) -> field:
    field m = absv(x)
    field q = (m - m % c) / c
    return if neg(x) then -q else q fi
def mulq(field a, field b) -> field:
    return divc(a * b, 4294967296)
def slice_index(field v) -> field:
    field n = if neg(v) then v+4 else v fi
    return if neg(n) then 0 else if n > 4 then 4 else n fi fi

def main(private field[4][4] a, private field[2] size) -> field[288]:
    field rw = -4
    field cw = -4
    for field t in 1..9 do
        field threshold = 2*(t-4)
        rw = if !lt(size[0], threshold) then t-4 else rw fi
        cw = if !lt(size[1], threshold) then t-4 else cw fi
    endfor
    field[288] out = [0; 288]
    for field j in 0..4 do
        field ymin = if lt(j-cw, 0) then 0 else j-cw fi
        field ymax = if lt(j+cw+1, 4) then j+cw+1 else 4 fi
        ymin = slice_index(ymin)
        ymax = slice_index(ymax)
        for field i in 0..4 do
            field xmin = if lt(i-rw, 0) then 0 else i-rw fi
            field xmax = if lt(i+rw+1, 4) then i+rw+1 else 4 fi
            xmin = slice_index(xmin)
            xmax = slice_index(xmax)
            field nr = if xmax > xmin then xmax-xmin else 0 fi
            field nc = if ymax > ymin then ymax-ymin else 0 fi
            field base = (j*4+i)*18
            out[base] = nr
            out[base+1] = nc
            for field r in 0..4 do
                for field c in 0..4 do
                    field ri = if r < nr then xmin+r else 0 fi
                    field ci = if c < nc then ymin+c else 0 fi
                    out[base+2+r*4+c] = if r < nr && c < nc then a[ri][ci] else 0 fi
                endfor
            endfor
        endfor
    endfor
    return out
