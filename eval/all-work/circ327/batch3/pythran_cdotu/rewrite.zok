// benchmarking/datasets/pythran/pythran_cdotu/kernel.py
// Signed integers use their canonical field residues; real inputs are Q32.
def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256
def absv(field x) -> field:
    return if neg(x) then -x else x fi
def lt(field a, field b) -> bool:
    return if neg(a) != neg(b) then neg(a) else a < b fi
// Constant integer rescaling uses native remainder and field division only.
def divc(field x, field c) -> field:
    field m = absv(x)
    field q = (m - m % c) / c
    return if neg(x) then -q else q fi
def mulq(field a, field b) -> field:
    return divc(a * b, 4294967296)
struct Complex {
    field re
    field im
}
def cadd(Complex a, Complex b) -> Complex:
    return Complex {re: a.re+b.re, im: a.im+b.im}
def cmul(Complex a, Complex b) -> Complex:
    return Complex {re: mulq(a.re,b.re)-mulq(a.im,b.im), im: mulq(a.re,b.im)+mulq(a.im,b.re)}

def main(private field N, private Complex[4] CX, private field INCX, private Complex[4] CY, private field INCY) -> field[3]:
    Complex ctemp = Complex {re: 0, im: 0}
    field ix = if neg(INCX) then (-N+1)*INCX else 0 fi
    field iy = if neg(INCY) then (-N+1)*INCY else 0 fi
    bool unit = INCX == 1 && INCY == 1
    for field k in 0..1024 do
        bool active = k < N
        field xidx = if unit then k else ix fi
        field yidx = if unit then k else iy fi
        xidx = if neg(xidx) then xidx+4 else xidx fi
        yidx = if neg(yidx) then yidx+4 else yidx fi
        xidx = if active then xidx else 0 fi
        yidx = if active then yidx else 0 fi
        Complex term = cmul(CX[xidx], CY[yidx])
        ctemp = if active then cadd(ctemp, term) else ctemp fi
        ix = if active && !unit then ix+INCX else ix fi
        iy = if active && !unit then iy+INCY else iy fi
    endfor
    return [if N == 0 then 0 else 1 fi, ctemp.re, ctemp.im]
