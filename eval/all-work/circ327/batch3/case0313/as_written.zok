// benchmarking/datasets/ds1000_numpy/generated/case0313/kernel.py
// Signed integers use their canonical field residues; real inputs are Q32.
def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256
def absv(field x) -> field:
    return if neg(x) then -x else x fi
def lt(field a, field b) -> bool:
    return if neg(a) != neg(b) then neg(a) else a < b fi
// Constant integer rescaling uses native remainder and field division only.
def divc(field x, field c) -> field:
    field m = absv(x)
    field q = (m - m % c) / c
    return if neg(x) then -q else q fi
def mulq(field a, field b) -> field:
    return divc(a * b, 4294967296)

def main(private field[8][6] a) -> field:
    field best = a[0][0]
    field bi = 0
    field bj = 0
    for field i in 0..8 do
        for field j in 0..6 do
            bool better = lt(best, a[i][j])
            bi = if better then i else bi fi
            bj = if better then j else bj fi
            best = if better then a[i][j] else best fi
        endfor
    endfor
    return bi * 6 + bj
