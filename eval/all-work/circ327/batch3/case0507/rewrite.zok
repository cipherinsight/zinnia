// benchmarking/datasets/ds1000_numpy/generated/case0507/kernel.py
// Signed integers use their canonical field residues; real inputs are Q32.
def neg(field x) -> bool:
    return x > 26217937587563095239723870254092982918845276250263818911301829349969290592256
def absv(field x) -> field:
    return if neg(x) then -x else x fi
def lt(field a, field b) -> bool:
    return if neg(a) != neg(b) then neg(a) else a < b fi
// Constant integer rescaling uses native remainder and field division only.
def divc(field x, field c) -> field:
    field m = absv(x)
    field q = (m - m % c) / c
    return if neg(x) then -q else q fi
def mulq(field a, field b) -> field:
    return divc(a * b, 4294967296)

def main(private field[5][6] im) -> field[32]:
    field rmin = 5
    field rmax = 0
    field cmin = 6
    field cmax = 0
    bool any = false
    for field i in 0..5 do
        for field j in 0..6 do
            bool nz = im[i][j] != 0
            rmin = if nz && i < rmin then i else rmin fi
            rmax = if nz && i > rmax then i else rmax fi
            cmin = if nz && j < cmin then j else cmin fi
            cmax = if nz && j > cmax then j else cmax fi
            any = any || nz
        endfor
    endfor
    field[32] out = [0; 32]
    field nr = if any then rmax - rmin + 1 else 0 fi
    field nc = if any then cmax - cmin + 1 else 0 fi
    out[0] = nr
    out[1] = nc
    for field i in 0..5 do
        for field j in 0..6 do
            field ri = if i < nr then i + rmin else 0 fi
            field cj = if j < nc then j + cmin else 0 fi
            out[2 + i*6+j] = if i < nr && j < nc then im[ri][cj] else 0 fi
        endfor
    endfor
    return out
