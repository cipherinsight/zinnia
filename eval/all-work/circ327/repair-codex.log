### pythran_caxpy CAXPY
# pythran program caxpy.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
@requires(lambda N, CA, CX, INCX, CY, INCY: 0 <= N <= 1024)
def CAXPY(N: Integer, CA: Complex, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
    if N <= 0:
        return
    if abs(CA) == 0.0:
        return
    if INCX == 1 and INCY == 1:
        'omp parallel for'
        for I in range(N):
            CY[I] = CY[I] + CA * CX[I]
    else:
        IX = 0
        IY = 0
        if INCX < 0:
            IX = (-N + 1) * INCX
        if INCY < 0:
            IY = (-N + 1) * INCY
        for I in range(N):
            CY[IY] = CY[IY] + CA * CX[IX]
            IX = IX + INCX
            IY = IY + INCY
    return CY


### pythran_lap laplacian
# pythran program lap.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy

@zk_circuit
@requires(lambda var, dh2: dh2 != 0.0)
def laplacian(var: Float[Array, '16'], dh2: Float):
    """ (1D array, dx^2) -> laplacian(1D array)
    periodic_laplacian_1D_4th_order
    Implementing the 4th order 1D laplacian with periodic condition
    """
    lap = numpy.zeros_like(var)
    lap[1:] = 4.0 / 3.0 * var[:-1]
    lap[0] = 4.0 / 3.0 * var[1]
    lap[:-1] += 4.0 / 3.0 * var[1:]
    lap[-1] += 4.0 / 3.0 * var[0]
    lap += -5.0 / 2.0 * var
    lap[2:] += -1.0 / 12.0 * var[:-2]
    lap[:2] += -1.0 / 12.0 * var[-2:]
    lap[:-2] += -1.0 / 12.0 * var[2:]
    lap[-2:] += -1.0 / 12.0 * var[:2]
    return lap / dh2


### pythran_lu factorMatrix1
# pythran program lu.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_circuit
def factorMatrix0(M: Float[Array, '5 5']):
    n = M.shape[0]
    m = M.shape[1]
    for line in range(0, n - 1):
        cmax = np.argmax(abs(M[line:n, line])) + line
        if cmax != line:
            M[[line, cmax]] = M[[cmax, line]]
        pivot = M[line, line]
        for j in range(line + 1, n):
            v = M[j, line] / pivot
            for k in range(line, m):
                M[j, k] -= v * M[line, k]

@zk_circuit
def factorMatrix1(M: Float[Array, '5 5']):
    n = M.shape[0]
    m = M.shape[1]
    for line in range(0, n - 1):
        cmax = line
        vmax = abs(M[line, line])
        for i in range(line + 1, n):
            if abs(M[i, line]) > vmax:
                vmax = abs(M[i, line])
                cmax = i
        if cmax != line:
            for j in range(line, m):
                t = M[line, j]
                M[line, j] = M[cmax, j]
                M[cmax, j] = t
        pivot = M[line, line]
        for j in range(line + 1, n):
            v = M[j, line] / pivot
            for k in range(line, m):
                M[j, k] -= v * M[line, k]


