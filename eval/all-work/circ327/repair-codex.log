from zinnia import *
import numpy as np

@zk_circuit
def kernel(M: Integer, float_n: Float, data: Float[Array, '16 14']):
    mean = np.mean(data, axis=0)
    data -= mean
    cov = np.zeros((M, M), dtype=data.dtype)
    for i in range(M):
        cov[i:M, i] = cov[i, i:M] = data[:, i] @ data[:, i:M] / (float_n - 1.0)
    return cov


