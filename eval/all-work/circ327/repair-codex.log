# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
@requires(lambda n: 0 <= n <= 1024)
def fibo(n: Integer):
    """ fibonaccie compuation. """
    a, b = (1, 1)
    for _ in range(n):
        a, b = (a + b, a)
    return a


### pythran_wdist slow_wdist
# pythran program wdist.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_circuit
def slow_wdist(A: Float[Array, '2 3'], B: Float[Array, '2 3'], W: Float[Array, '2 3']):
    k, m = A.shape
    _, n = B.shape
    D = np.zeros((m, n))
    for ii in range(m):
        for jj in range(n):
            wdiff = (A[:, ii] - B[:, jj]) / W[:, ii]
            D[ii, jj] = np.sqrt((wdiff ** 2).sum())
    return D


### pythran_cronbach cronbach
# pythran program cronbach.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
def cronbach(itemscores: Float[Array, '16 16']):
    itemvars = itemscores.var(1, None, None, 1)
    tscores = itemscores.sum(0)
    nitems = len(itemscores)
    return nitems / (nitems - 1) * (1 - itemvars.sum() / tscores.var(None, None, None, 1))


### pythran_gauss gauss
# pythran program gauss.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_chip
def pivot(n, i, a, b):
    i0 = i
    amp0 = abs(a[i - 1][i - 1])
    for j in range(i + 1, n + 1):
        amp = abs(a[i - 1][j - 1])
        if amp > amp0:
            i0 = j
            amp0 = amp
    if i == i0:
        return
    temp = b[i - 1]
    b[i - 1] = b[i0 - 1]
    b[i0 - 1] = temp
    for j in range(i, n + 1):
        temp = a[j - 1][i - 1]
        a[j - 1][i - 1] = a[j - 1][i0 - 1]
        a[j - 1][i0 - 1] = temp

@zk_circuit
@requires(lambda n, a, b: 0 <= n <= 1024)
def gauss(n: Integer, a: Float[Array, '4 4'], b: Float[Array, '4']):
    for i in range(1, n + 1):
        if i < n:
            pivot(n, i, a, b)
        a[i - 1][i - 1] = 1.0 / a[i - 1][i - 1]
        b[i - 1] = b[i - 1] * a[i - 1][i - 1]
        if i < n:
            for j in range(i + 1, n + 1):
                a[j - 1][i - 1] = a[j - 1][i - 1] * a[i - 1][i - 1]
            for k in range(i + 1, n + 1):
                b[k - 1] = b[k - 1] - a[i - 1][k - 1] * b[i - 1]
                for j in range(i + 1, n + 1):
                    a[j - 1][k - 1] = a[j - 1][k - 1] - a[i - 1][k - 1] * a[j - 1][i - 1]
    for i in range(n - 1, 0, -1):
        for j in range(i, n):
            b[i - 1] = b[i - 1] - a[j][i - 1] * b[j]
    return b


### pythran_weights weights
# pythran program weights.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_circuit
def weights(input_data: Integer[Array, '5 2'], threshold: Float=0.3):
    n_seq, length = input_data.shape
    weights = np.zeros(n_seq, dtype=np.float32)
    for i in range(n_seq):
        vector = input_data[i, None, :]
        count_matches = np.sum(vector == input_data, axis=1)
        over_threshold = count_matches > threshold * length
        total = np.sum(over_threshold)
        weights[i] = 1 / total
    return weights


