@zk_circuit
def next_pythagorean_triples(previous: Integer[Array, '1 3']):
    matrices = np.array([[-1, 2, 2], [-2, 1, 2], [-2, 2, 3], [1, 2, 2], [2, 1, 2], [2, 2, 3], [1, -2, 2], [2, -1, 2], [2, -2, 3]])
    next_triples = np.transpose(np.dot(matrices, np.transpose(previous)))
