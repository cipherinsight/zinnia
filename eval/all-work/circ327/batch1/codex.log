@zk_circuit
def kernel(arr: Float[Array, "41 13"], shape: Integer[Array, "2"]):
    result = np.pad(arr, ((0, shape[0]-arr.shape[0]), (0, shape[1]-arr.shape[1])), 'constant')

    return result

