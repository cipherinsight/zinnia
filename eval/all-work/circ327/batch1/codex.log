### pythran_fft
# pythran program fft.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import math, numpy as np

@zk_circuit
def fft(x: Complex[Array, '16']):
    N = x.shape[0]
    if N == 1:
        return np.array(x)
    e = fft(x[::2])
    o = fft(x[1::2])
    M = N // 2
    l = [e[k] + o[k] * math.e ** (-2j * math.pi * k / N) for k in range(M)]
    r = [e[k] - o[k] * math.e ** (-2j * math.pi * k / N) for k in range(M)]
    return np.array(l + r)


### pythran_growcut
# pythran program growcut.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import math
import numpy as np

@zk_chip
def window_floor(idx, radius):
    if radius > idx:
        return 0
    else:
        return idx - radius

@zk_chip
def window_ceil(idx, ceil, radius):
    if idx + radius > ceil:
        return ceil
    else:
        return idx + radius

@zk_chip
def python_kernel(image, state, state_next, window_radius):
    changes = 0
    sqrt_3 = math.sqrt(3.0)
    height = image.shape[0]
    width = image.shape[1]
    for j in range(width):
        for i in range(height):
            winning_colony = state[i, j, 0]
            defense_strength = state[i, j, 1]
            for jj in range(window_floor(j, window_radius), window_ceil(j + 1, width, window_radius)):
                for ii in range(window_floor(i, window_radius), window_ceil(i + 1, height, window_radius)):
                    if ii == i and jj == j:
                        continue
                    d = image[i, j, 0] - image[ii, jj, 0]
                    s = d * d
                    for k in range(1, 3):
                        d = image[i, j, k] - image[ii, jj, k]
                        s += d * d
                    gval = 1.0 - math.sqrt(s) / sqrt_3
                    attack_strength = gval * state[ii, jj, 1]
                    if attack_strength > defense_strength:
                        defense_strength = attack_strength
                        winning_colony = state[ii, jj, 0]
                        changes += 1
            state_next[i, j, 0] = winning_colony
            state_next[i, j, 1] = defense_strength
    return changes

@zk_circuit
@requires(lambda N: 0 <= N <= 1024)
def test(N: Integer):
    image = np.zeros((N, N, 3))
    state = np.zeros((N, N, 2))
    state_next = np.empty_like(state)
    state[0, 0, 0] = 1
    state[0, 0, 1] = 1
    return python_kernel(image, state, state_next, 10)


