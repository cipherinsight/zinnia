from zinnia import *
import numpy as np

@zk_circuit
def factorMatrix0(M: Float[Array, '5 5']):
    n = M.shape[0]
    m = M.shape[1]
    for line in range(0, n - 1):
        cmax = np.argmax(abs(M[line:n, line])) + line
        if cmax != line:
            M[[line, cmax]] = M[[cmax, line]]
        pivot = M[line, line]
        for j in range(line + 1, n):
            v = M[j, line] / pivot
            for k in range(line, m):
                M[j, k] -= v * M[line, k]

@zk_circuit
