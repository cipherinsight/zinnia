from zinnia import *

@zk_circuit
@requires(lambda N, CX, INCX, CY, INCY: 0 <= N <= 1024)
def CCOPY(N: Integer, CX: Complex[Array, '4'], INCX: Integer, CY: Complex[Array, '4'], INCY: Integer):
    if N <= 0:
        return
    if INCX == 1 and INCY == 1:
        for I in range(N):
            CY[I] = CX[I]
    else:
        IX = 0
        IY = 0
        if INCX < 0:
            IX = (-N + 1) * INCX
        if INCY < 0:
            IY = (-N + 1) * INCY
        for I in range(N):
            CY[IY] = CX[IX]
            IX = IX + INCX
            IY = IY + INCY
    return


### pythran_collatz
# pythran program collatz.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_circuit
@requires(lambda n_max: 0 <= n_max <= 1024)
def collatz(n_max: Integer):
    n = np.arange(3, n_max + 1)
    count = np.ones_like(n)
    indices = n != 1
    while np.any(indices):
        count[indices] += 1
        x = n[indices]
        n[indices] = np.where(x & 1, 3 * x + 1, x // 2)
        indices = n != 1
    max_i = np.argmax(count)
    return (max_i + 3, count[max_i])


### pythran_crotg
# pythran program crotg.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import math

@zk_circuit
def CROTG(CA: Complex, CB: Complex, C: Float=0, S: Complex=0):
    if abs(CA) == 0.0:
        C = 0.0
        S = complex(1.0, 0.0)
        CA = CB
    else:
        SCALE = abs(CA) + abs(CB)
        NORM = SCALE * math.sqrt(abs(CA / SCALE) ** 2 + abs(CB / SCALE) ** 2)
        ALPHA = CA / abs(CA)
        C = abs(CA) / NORM
        S = ALPHA * CB.conjugate() / NORM
        CA = ALPHA * NORM
    return (CA, CB, C, S)


