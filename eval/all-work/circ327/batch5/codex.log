### npbench_weather_stencils_hdiff_hdiff
# npbench program weather_stencils/hdiff/hdiff_numpy.py (spcl/npbench npbench/benchmarks).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_circuit
def hdiff(in_field: Float[Array, '15 15 10'], out_field: Float[Array, '11 11 10'], coeff: Float[Array, '11 11 10']):
    I, J, K = (out_field.shape[0], out_field.shape[1], out_field.shape[2])
    lap_field = 4.0 * in_field[1:I + 3, 1:J + 3, :] - (in_field[2:I + 4, 1:J + 3, :] + in_field[0:I + 2, 1:J + 3, :] + in_field[1:I + 3, 2:J + 4, :] + in_field[1:I + 3, 0:J + 2, :])
    res = lap_field[1:, 1:J + 1, :] - lap_field[:-1, 1:J + 1, :]
    flx_field = np.where(res * (in_field[2:I + 3, 2:J + 2, :] - in_field[1:I + 2, 2:J + 2, :]) > 0, 0, res)
    res = lap_field[1:I + 1, 1:, :] - lap_field[1:I + 1, :-1, :]
    fly_field = np.where(res * (in_field[2:I + 2, 2:J + 3, :] - in_field[2:I + 2, 1:J + 2, :]) > 0, 0, res)
    out_field[:, :, :] = in_field[2:I + 2, 2:J + 2, :] - coeff[:, :, :] * (flx_field[1:, :, :] - flx_field[:-1, :, :] + fly_field[:, 1:, :] - fly_field[:, :-1, :])


### pythran_another_quicksort
# pythran program another_quicksort.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_chip
def swap(l, idx1, idx2):
    if idx1 != idx2:
        tmp = l[idx1]
        l[idx1] = l[idx2]
        l[idx2] = tmp

@zk_chip
def partition(l):
    size = len(l)
    pivot_idx = size // 2
    val = l[pivot_idx]
    idx = size - 1
    if pivot_idx != idx:
        swap(l, pivot_idx, idx)
    idx = idx - 1
    i = 0
    while i <= idx:
        if l[i] > val:
            while l[idx] > val and idx > i:
                idx = idx - 1
            if idx != i:
                swap(l, i, idx)
                idx = idx - 1
            else:
                break
        i = i + 1
    assert idx == i or idx + 1 == i
    swap(l, i, size - 1)
    return i

@zk_circuit
def QuickSort(l: Integer[Array, '10']):
    size = len(l)
    if size > 1:
        idx = partition(l)
        l1 = []
        l2 = []
        for i in range(0, idx):
            l1.append(l[i])
        for i in range(idx, size):
            l2.append(l[i])
        QuickSort(l1)
        QuickSort(l2)
        for i in range(0, len(l1)):
            l[i] = l1[i]
        for i in range(0, len(l2)):
            l[len(l1) + i] = l2[i]
    return l


### pythran_calculate_u
# pythran program calculate_u.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *

@zk_circuit
@requires(lambda t, t_stop, dt, dx, dy, u, um, k: dt != 0.0)
@requires(lambda t, t_stop, dt, dx, dy, u, um, k: dx != 0.0)
@requires(lambda t, t_stop, dt, dx, dy, u, um, k: dy != 0.0)
def timeloop(t: Float, t_stop: Float, dt: Float, dx: Float, dy: Float, u: Integer[Array, '5 10'], um: Integer[Array, '5 10'], k: Integer[Array, '5 10']):
    while t <= t_stop:
        t += dt
        new_u = calculate_u(dt, dx, dy, u, um, k)
        um = u
        u = new_u
    return u

@zk_chip
def calculate_u(dt, dx, dy, u, um, k):
    up = [[0.0] * len(u[0]) for i in range(len(u))]
    'omp parallel for'
    for i in range(1, len(u) - 1):
        for j in range(1, len(u[0]) - 1):
            up[i][j] = 2 * u[i][j] - um[i][j] + (dt / dx) ** 2 * (0.5 * (k[i + 1][j] + k[i][j]) * (u[i + 1][j] - u[i][j]) - 0.5 * (k[i][j] + k[i - 1][j]) * (u[i][j] - u[i - 1][j])) + (dt / dy) ** 2 * (0.5 * (k[i][j + 1] + k[i][j]) * (u[i][j + 1] - u[i][j]) - 0.5 * (k[i][j] + k[i][j - 1]) * (u[i][j] - u[i][j - 1]))
    return up


### pythran_clip
# pythran program clip.py (serge-sans-paille/pythran pythran/tests/cases).
# Function bodies are the upstream text. Entry-function annotations are derived from upstream
# types by benchmarking/datasets/tools/acceptance_case_set.py; see datasets/case_sets/acceptance.json.

from zinnia import *
import numpy as np

@zk_chip
def limit1(x, epsilon=1e-06):
    if abs(x) < epsilon:
        return 0
    else:
        return x / abs(x)

@zk_circuit
def clip(z: Complex[Array, '2'], _max: Float):
    out = np.empty(z.shape, dtype=z.dtype)
    for i in range(len(z)):
        if abs(z[i]) > _max:
            out[i] = limit1(z[i]) * _max
        else:
            out[i] = z[i]
    return out


