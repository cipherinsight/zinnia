def main(private u64[10] x) -> u64[10]:
    u64[10] rev = [0u64; 10]
    for u32 i in 0..10 do
        rev[i] = x[9u32-i]
    endfor
    u64 total = 0u64
    u64[10] result = [0u64; 10]
    for u32 i in 0..10 do
        total = total + rev[i]
        result[9u32-i] = total
    endfor
    return result
