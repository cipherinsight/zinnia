def lt(u64 a, u64 b) -> bool:
    return (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)

def main(private u64[16][16] array_1, private u64[16][16] array_2, private u64 a, private u64 b, private u64 c) -> u64[16][16]:
    u64[16][16] result = [[0u64; 16]; 16]
    for u32 i in 0..16 do
        for u32 j in 0..16 do
            u64 x = if lt(array_1[i][j], 2u64) then 2u64 else if lt(10u64, array_1[i][j]) then 10u64 else array_1[i][j] fi fi
            result[i][j] = x*a+array_2[i][j]*b+c
        endfor
    endfor
    return result
