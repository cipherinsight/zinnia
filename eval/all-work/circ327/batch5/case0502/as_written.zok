def lt(u64 a, u64 b) -> bool:
    return (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)

def main(private u64[13][13][2] a, private u64[13][13] b) -> u64[13][13]:
    u64[13][13] result = [[0u64; 13]; 13]
    for u32 i in 0..13 do
        for u32 j in 0..13 do
            u64 ix = if lt(b[i][j], 0u64) then b[i][j]+2u64 else b[i][j] fi
            result[i][j] = a[i][j][ix]
        endfor
    endfor
    return result
