def lt(u64 a, u64 b) -> bool:
    return (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)

def main(private u64[10][5] a) -> bool[10][5]:
    bool[10][5] result = [[false; 5]; 10]
    for u32 i in 0..10 do
        u64 m = a[i][0]
        for u32 j in 1..5 do
            m = if lt(m, a[i][j]) then a[i][j] else m fi
        endfor
        for u32 j in 0..5 do
            result[i][j] = m == a[i][j]
        endfor
    endfor
    return result
