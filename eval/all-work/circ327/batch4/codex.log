18: @zk_circuit
19: def conv(x: Float[Array, '16 16'], weights: Float[Array, '5 5']):
20:     sx = x.shape
21:     sw = weights.shape
22:     result = np.zeros_like(x)
23:     for i in range(sx[0]):
24:         for j in range(sx[1]):
25:             for ii in range(sw[0]):
26:                 for jj in range(sw[1]):
27:                     idx = (clamp(i, ii - sw[0] // 2, sw[0]), clamp(j, jj - sw[0] // 2, sw[0]))
28:                     result[i, j] += x[idx] * weights[ii, jj]
29:     return result

### pythran_fannkuch
4: 
5: from zinnia import *
6: 
7: @zk_chip
8: def fannkuch(n):
9:     count = list(range(1, n + 1))
10:     max_flips = 0
11:     m = n - 1
12:     r = n
13:     check = 0
14:     perm1 = list(range(n))
15:     perm = list(range(n))
16:     while 1:
17:         if check < 30:
18:             check += 1
19:         while r != 1:
20:             count[r - 1] = r
21:             r -= 1
22:         if perm1[0] != 0 and perm1[m] != m:
23:             perm = perm1[:]
24:             flips_count = 0
25:             k = perm[0]
26:             while k:
27:                 perm[:k + 1] = perm[k::-1]
28:                 flips_count += 1
29:                 k = perm[0]
30:             if flips_count > max_flips:
31:                 max_flips = flips_count
32:         while r != n:
33:             perm1.insert(r, perm1.pop(0))
34:             count[r] -= 1
35:             if count[r] > 0:
36:                 break
37:             r += 1
38:         else:
39:             return max_flips
40: 
41: @zk_circuit
42: @requires(lambda n: 0 <= n <= 1024)
43: def fannkuch2(n: Integer):
44:     fannkuch(n)

### pythran_gauss
4: 
5: from zinnia import *
6: 
7: @zk_chip
8: def pivot(n, i, a, b):
9:     i0 = i
10:     amp0 = abs(a[i - 1][i - 1])
11:     for j in range(i + 1, n + 1):
12:         amp = abs(a[i - 1][j - 1])
13:         if amp > amp0:
14:             i0 = j
15:             amp0 = amp
16:     if i == i0:
17:         return
18:     temp = b[i - 1]
19:     b[i - 1] = b[i0 - 1]
20:     b[i0 - 1] = temp
21:     for j in range(i, n + 1):
22:         temp = a[j - 1][i - 1]
23:         a[j - 1][i - 1] = a[j - 1][i0 - 1]
24:         a[j - 1][i0 - 1] = temp
25: 
26: @zk_circuit
27: @requires(lambda n, a, b: 0 <= n <= 1024)
28: def gauss(n: Integer, a: Float[Array, '4 4'], b: Float[Array, '4']):
29:     for i in range(1, n + 1):
30:         if i < n:
31:             pivot(n, i, a, b)
32:         a[i - 1][i - 1] = 1.0 / a[i - 1][i - 1]
33:         b[i - 1] = b[i - 1] * a[i - 1][i - 1]
34:         if i < n:
35:             for j in range(i + 1, n + 1):
36:                 a[j - 1][i - 1] = a[j - 1][i - 1] * a[i - 1][i - 1]
37:             for k in range(i + 1, n + 1):
38:                 b[k - 1] = b[k - 1] - a[i - 1][k - 1] * b[i - 1]
39:                 for j in range(i + 1, n + 1):
40:                     a[j - 1][k - 1] = a[j - 1][k - 1] - a[i - 1][k - 1] * a[j - 1][i - 1]
41:     for i in range(n - 1, 0, -1):
42:         for j in range(i, n):
43:             b[i - 1] = b[i - 1] - a[j][i - 1] * b[j]
44:     return b

### pythran_hasting
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: def fweb(y: Float[Array, '3'], t: Float, a1: Float, a2: Float, b1: Float, b2: Float, d1: Float, d2: Float):
10:     yprime = np.empty((3,))
11:     yprime[0] = y[0] * (1.0 - y[0]) - a1 * y[0] * y[1] / (1.0 + b1 * y[0])
12:     yprime[1] = a1 * y[0] * y[1] / (1.0 + b1 * y[0]) - a2 * y[1] * y[2] / (1.0 + b2 * y[1]) - d1 * y[1]
13:     yprime[2] = a2 * y[1] * y[2] / (1.0 + b2 * y[1]) - d2 * y[2]
14:     return yprime

### pythran_lap
4: 
5: from zinnia import *
6: import numpy
7: 
8: @zk_circuit
9: @requires(lambda var, dh2: dh2 != 0.0)
10: def laplacian(var: Float[Array, '16'], dh2: Float):
11:     """ (1D array, dx^2) -> laplacian(1D array)
12:     periodic_laplacian_1D_4th_order
13:     Implementing the 4th order 1D laplacian with periodic condition
14:     """
15:     lap = numpy.zeros_like(var)
16:     lap[1:] = 4.0 / 3.0 * var[:-1]
17:     lap[0] = 4.0 / 3.0 * var[1]
18:     lap[:-1] += 4.0 / 3.0 * var[1:]
19:     lap[-1] += 4.0 / 3.0 * var[0]
20:     lap += -5.0 / 2.0 * var
21:     lap[2:] += -1.0 / 12.0 * var[:-2]
22:     lap[:2] += -1.0 / 12.0 * var[-2:]
23:     lap[:-2] += -1.0 / 12.0 * var[2:]
24:     lap[-2:] += -1.0 / 12.0 * var[:2]
25:     return lap / dh2

### pythran_log_likelihood
4: 
5: from zinnia import *
6: import numpy
7: 
8: @zk_circuit
9: @requires(lambda data, mean, sigma: sigma != 0.0)
10: def log_likelihood(data: Float[Array, '16'], mean: Float, sigma: Float):
11:     s = (data - mean) ** 2 / (2 * sigma ** 2)
12:     pdfs = numpy.exp(-s)
13:     pdfs /= numpy.sqrt(2 * numpy.pi) * sigma
14:     return numpy.log(pdfs).sum()

### pythran_mandel
4: 
5: from zinnia import *
6: 
7: @zk_circuit
8: @requires(lambda size, x_center, y_center, max_iteration: 0 <= size <= 1024)
9: @requires(lambda size, x_center, y_center, max_iteration: size != 0)
10: def mandel(size: Integer, x_center: Float, y_center: Float, max_iteration: Integer):
11:     out = [[0 for i in range(size)] for j in range(size)]
12:     for i in range(size):
13:         'omp parallel for'
14:         for j in range(size):
15:             x, y = (x_center + 4.0 * float(i - size / 2) / size, y_center + 4.0 * float(j - size / 2) / size)
16:             a, b = (0.0, 0.0)
17:             iteration = 0
18:             while a ** 2 + b ** 2 <= 4.0 and iteration < max_iteration:
19:                 a, b = (a ** 2 - b ** 2 + x, 2 * a * b + y)
20:                 iteration += 1
21:             if iteration == max_iteration:
22:                 color_value = 255
23:             else:
24:                 color_value = iteration * 10 % 255
25:             out[i][j] = color_value
26:     return out

