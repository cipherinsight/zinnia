### pythran_pairwise
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: def pairwise(X: Float[Array, '16 8']):
10:     M, N = X.shape
11:     D = np.empty((M, M))
12:     for i in range(M):
13:         for j in range(M):
14:             d = 0.0
15:             for k in range(N):
16:                 tmp = X[i, k] - X[j, k]
17:                 d += tmp * tmp
18:             D[i, j] = np.sqrt(d)
19:     return D

### pythran_primes_sieve2
4: 
5: from zinnia import *
6: 
7: @zk_circuit
8: @requires(lambda n: 0 <= n <= 1024)
9: def get_primes7(n: Integer):
10:     """
11: 	standard optimized sieve algorithm to get a list of prime numbers
12: 	--- this is the function to compare your functions against! ---
13: 	"""
14:     if n < 2:
15:         return []
16:     if n == 2:
17:         return [2]
18:     s = list(range(3, n + 1, 2))
19:     mroot = n ** 0.5
20:     half = len(s)
21:     i = 0
22:     m = 3
23:     while m <= mroot:
24:         if s[i]:
25:             j = (m * m - 3) // 2
26:             s[j] = 0
27:             while j < half:
28:                 s[j] = 0
29:                 j += m
30:         i = i + 1
31:         m = 2 * i + 3
32:     return [2] + [x for x in s if x]

