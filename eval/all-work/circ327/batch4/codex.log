### pythran_convnet
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_chip
9: def sigmoid(z):
10:     return 1 / (1 + np.exp(-z))
11: 
12: @zk_circuit
13: def convnet(conv_matrix: Float[Array, '4 4'], qcnn_filter: Float[Array, '4 4'], length: Integer, batch_size: Integer, state_size: Integer):
14:     state_size_2 = state_size * 2
15:     state_size_3 = state_size * 3
16:     state_size_4 = state_size * 4
17:     conv_results = np.dot(conv_matrix, qcnn_filter).reshape(length, batch_size, state_size_4)
18:     conv_results[:, :, :state_size] = np.tanh(conv_results[:, :, :state_size])
19:     conv_results[:, :, state_size:state_size_4] = sigmoid(conv_results[:, :, state_size:state_size_4])
20:     state_results = np.zeros((batch_size, length, state_size_2), dtype=np.float32)
21:     state = np.zeros((batch_size, state_size), dtype=np.float32)
22:     for i in range(length):
23:         z = conv_results[i, :, :state_size]
24:         f = conv_results[i, :, state_size:state_size_2]
25:         o = conv_results[i, :, state_size_2:state_size_3]
26:         state = f * state + (1 - f) * z
27:         state_results[:, i, :state_size] = state * o
28:     state = np.zeros((batch_size, state_size), dtype=np.float32)
29:     for i in range(length - 1, -1, -1):
30:         z = conv_results[i, :, :state_size]
31:         f = conv_results[i, :, state_size_3:state_size_4]
32:         o = conv_results[i, :, state_size_2:state_size_3]
33:         state = f * state + (1 - f) * z
34:         state_results[:, i, state_size:] = state * o
35:     state_results = state_results.reshape((batch_size * length, state_size_2))
36:     return state_results

### pythran_deuxd_convolution
