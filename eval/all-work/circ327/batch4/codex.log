### npbench_stockham_fft_stockham_fft
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: @requires(lambda N, R, K, x, y: R != 0)
10: def stockham_fft(N: Integer, R: Integer, K: Integer, x: Complex[Array, '16'], y: Complex[Array, '16']):
11:     i_coord, j_coord = np.mgrid[0:R, 0:R]
12:     dft_mat = np.empty((R, R), dtype=np.complex128)
13:     dft_mat = np.exp(-2j * np.pi * i_coord * j_coord / R)
14:     y[:] = x[:]
15:     ii_coord, jj_coord = np.mgrid[0:R, 0:R ** K]
16:     for i in range(K):
17:         yv = np.reshape(y, (R ** i, R, R ** (K - i - 1)))
18:         tmp_perm = np.transpose(yv, axes=(1, 0, 2))
19:         D = np.empty((R, R ** i, R ** (K - i - 1)), dtype=np.complex128)
20:         tmp = np.exp(-2j * np.pi * ii_coord[:, :R ** i] * jj_coord[:, :R ** i] / R ** (i + 1))
21:         D[:] = np.repeat(np.reshape(tmp, (R, R ** i, 1)), R ** (K - i - 1), axis=2)
22:         tmp_twid = np.reshape(tmp_perm, (N,)) * np.reshape(D, (N,))
23:         y[:] = np.reshape(dft_mat @ np.reshape(tmp_twid, (R, R ** (K - 1))), (N,))

