### npbench_nbody_nbody
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_chip
9: def getAcc(pos, mass, G, softening):
10:     """
11:     Calculate the acceleration on each particle due to Newton's Law 
12:     pos  is an N x 3 matrix of positions
13:     mass is an N x 1 vector of masses
14:     G is Newton's Gravitational constant
15:     softening is the softening length
16:     a is N x 3 matrix of accelerations
17:     """
18:     x = pos[:, 0:1]
19:     y = pos[:, 1:2]
20:     z = pos[:, 2:3]
21:     dx = x.T - x
22:     dy = y.T - y
23:     dz = z.T - z
24:     inv_r3 = dx ** 2 + dy ** 2 + dz ** 2 + softening ** 2
25:     inv_r3[inv_r3 > 0] = inv_r3[inv_r3 > 0] ** (-1.5)
26:     ax = G * (dx * inv_r3) @ mass
27:     ay = G * (dy * inv_r3) @ mass
28:     az = G * (dz * inv_r3) @ mass
29:     a = np.hstack((ax, ay, az))
30:     return a
31: 
32: @zk_chip
33: def getEnergy(pos, vel, mass, G):
34:     """
35:     Get kinetic energy (KE) and potential energy (PE) of simulation
36:     pos is N x 3 matrix of positions
37:     vel is N x 3 matrix of velocities
38:     mass is an N x 1 vector of masses
39:     G is Newton's Gravitational constant
40:     KE is the kinetic energy of the system
41:     PE is the potential energy of the system
42:     """
43:     KE = 0.5 * np.sum(mass * vel ** 2)
44:     x = pos[:, 0:1]
45:     y = pos[:, 1:2]
46:     z = pos[:, 2:3]
47:     dx = x.T - x
48:     dy = y.T - y
49:     dz = z.T - z
50:     inv_r = np.sqrt(dx ** 2 + dy ** 2 + dz ** 2)
51:     inv_r[inv_r > 0] = 1.0 / inv_r[inv_r > 0]
52:     PE = G * np.sum(np.triu(-(mass * mass.T) * inv_r, 1))
53:     return (KE, PE)
54: 
55: @zk_circuit
56: @requires(lambda mass, pos, vel, N, Nt, dt, G, softening: 0 <= N <= 1024)
57: @requires(lambda mass, pos, vel, N, Nt, dt, G, softening: dt != 0.0)
58: def nbody(mass: Float[Array, '13 1'], pos: Float[Array, '13 3'], vel: Float[Array, '13 3'], N: Integer, Nt: Integer, dt: Float, G: Float, softening: Float):
59:     vel -= np.mean(mass * vel, axis=0) / np.mean(mass)
60:     acc = getAcc(pos, mass, G, softening)
61:     KE = np.ndarray(Nt + 1, dtype=np.float64)
62:     PE = np.ndarray(Nt + 1, dtype=np.float64)
63:     KE[0], PE[0] = getEnergy(pos, vel, mass, G)
64:     t = 0.0
65:     for i in range(Nt):
66:         vel += acc * dt / 2.0
67:         pos += vel * dt
68:         acc = getAcc(pos, mass, G, softening)
69:         vel += acc * dt / 2.0
70:         t += dt
71:         KE[i + 1], PE[i + 1] = getEnergy(pos, vel, mass, G)
72:     return (KE, PE)

