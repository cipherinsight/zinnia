5: from zinnia import *
6: import math
7: 
8: @zk_chip
9: def isprime(n):
10:     """Returns True if n is prime and False otherwise"""
11:     if n < 2:
12:         return False
13:     if n == 2:
14:         return True
15:     max = int(math.ceil(math.sqrt(n)))
16:     i = 2
17:     while i <= max:
18:         if n % i == 0:
19:             return False
20:         i += 1
21:     return True
22: 
23: @zk_circuit
