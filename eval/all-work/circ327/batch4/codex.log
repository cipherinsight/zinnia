### npbench_polybench_ludcmp_ludcmp
4: 
5: from zinnia import *
6: import numpy as np
7: 
8: @zk_circuit
9: def kernel(A: Float[Array, '15 15'], b: Float[Array, '15']):
10:     x = np.zeros_like(b)
11:     y = np.zeros_like(b)
12:     for i in range(A.shape[0]):
13:         for j in range(i):
14:             A[i, j] -= A[i, :j] @ A[:j, j]
15:             A[i, j] /= A[j, j]
16:         for j in range(i, A.shape[0]):
17:             A[i, j] -= A[i, :i] @ A[:i, j]
18:     for i in range(A.shape[0]):
19:         y[i] = b[i] - A[i, :i] @ y[:i]
20:     for i in range(A.shape[0] - 1, -1, -1):
21:         x[i] = (y[i] - A[i, i + 1:] @ x[i + 1:]) / A[i, i]
22:     return (x, y)

