from "../native_v1" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64[8][6] a, private u64 col, private u64 multiply_number) -> u64[8]:
    u64 idx = (col - 1)
    u64 ci = integer_to_field(if neg(idx) then (idx + 6) else idx fi)
    for u32 i in 0..8 do
        a[i][ci] = mulq(a[i][ci], multiply_number)
    endfor
    u64[8] r = [0u64;8]
    u64 acc = 0
    for u32 i in 0..8 do
        acc = (acc + a[i][ci])
        r[i] = acc
    endfor
    return r
