from "../native" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64 alpha, private u64 beta, private u64[14][15] A, private u64[15][15] B, private u64[15][16] C, private u64[14][16] D) -> u64[14][16]:
    u64[14][15] tmp = [[0u64;15];14]
    for u32 i in 0..14 do
        for u32 j in 0..15 do
            for u32 k in 0..15 do
                tmp[i][j] = (tmp[i][j] + mulq(mulq(alpha, A[i][k]), B[k][j]))
            endfor
        endfor
    endfor
    for u32 i in 0..14 do
        for u32 j in 0..16 do
            u64 s = 0
            for u32 k in 0..15 do
                s = (s + mulq(tmp[i][k], C[k][j]))
            endfor
            D[i][j] = (s + mulq(beta, D[i][j]))
        endfor
    endfor
    return D
