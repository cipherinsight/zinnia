from "../native" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64 alpha, private u64[13][13] A, private u64[13][16] B) -> u64[13][16]:
    for u32 i in 0..13 do
        for u32 j in 0..16 do
            u64 dot = 0
            for u32 k in i+1..13 do
                dot = (dot + mulq(A[k][i], B[k][j]))
            endfor
            B[i][j] = (B[i][j] + dot)
        endfor
    endfor
    for u32 i in 0..13 do
        for u32 j in 0..16 do
            B[i][j] = mulq(B[i][j], alpha)
        endfor
    endfor
    return B
