from "../native" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64 N, private u64[4][2] CX, private u64 INCX, private u64[4][2] CY, private u64 INCY) -> u64[3]:
    u64[3] result = [0;3]
    u64 ix = if neg(INCX) then (((0u64-N) + 1) * INCX) else 0 fi
    u64 iy = if neg(INCY) then (((0u64-N) + 1) * INCY) else 0 fi
    for u32 I in 0..1024 do
        u64 x = if ((INCX == 1) && (INCY == 1)) then it(I) else ix fi
        u64 y = if ((INCX == 1) && (INCY == 1)) then it(I) else iy fi
        x = if neg(x) then (x + 4) else x fi
        y = if neg(y) then (y + 4) else y fi
        result[1] = if lt(it(I), N) then ((result[1] + mul(CX[ui(x)][0], CY[ui(y)][0])) + mul(CX[ui(x)][1], CY[ui(y)][1])) else result[1] fi
        result[2] = if lt(it(I), N) then ((result[2] + mul(CX[ui(x)][0], CY[ui(y)][1])) - mul(CX[ui(x)][1], CY[ui(y)][0])) else result[2] fi
        ix = (ix + INCX)
        iy = (iy + INCY)
    endfor
    result[0] = if (!neg(N) && N != 0u64) then 1 else 0 fi
    return result
