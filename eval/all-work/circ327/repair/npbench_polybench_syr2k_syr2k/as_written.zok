from "../native" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64 alpha, private u64 beta, private u64[13][13] C, private u64[13][9] A, private u64[13][9] B) -> u64[13][13]:
    for u32 i in 0..13 do
        for u32 j in 0..i+1 do
            C[i][j] = mulq(C[i][j], beta)
        endfor
        for u32 k in 0..9 do
            for u32 j in 0..i+1 do
                C[i][j] = ((C[i][j] + mulq(mulq(A[j][k], alpha), B[i][k])) + mulq(mulq(B[j][k], alpha), A[i][k]))
            endfor
        endfor
    endfor
    return C
