from "../native_v1" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64[4][16][16][2] input, private u64[2][2][2][8] weights, private u64[8] bias) -> u64[4][15][15][8]:
    u64[4][15][15][8] output = [[[[0;8];15];15];4]
    for u32 i in 0..15 do
        for u32 j in 0..15 do
            for u32 n in 0..4 do
                for u32 c in 0..8 do
                    u64 total = 0
                    for u32 di in 0..2 do
                        for u32 dj in 0..2 do
                            for u32 k in 0..2 do
                                total = (total + mul(input[n][(i + di)][(j + dj)][k], weights[di][dj][k][c]))
                            endfor
                        endfor
                    endfor
                    output[n][i][j][c] = total
                endfor
            endfor
        endfor
    endfor
    for u32 n in 0..4 do
        for u32 i in 0..15 do
            for u32 j in 0..15 do
                for u32 c in 0..8 do
                    output[n][i][j][c] = (output[n][i][j][c] + bias[c])
                endfor
            endfor
        endfor
    endfor
    return output
