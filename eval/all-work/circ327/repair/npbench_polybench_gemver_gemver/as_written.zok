from "../native_v1" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

struct Result {
    u64[16][16] v0
    u64[16] v1
    u64[16] v2
}
def main(private u64 alpha, private u64 beta, private u64[16][16] A, private u64[16] u1, private u64[16] v1, private u64[16] u2, private u64[16] v2, private u64[16] w, private u64[16] x, private u64[16] y, private u64[16] z) -> Result:
    for u32 i in 0..16 do
        for u32 j in 0..16 do
            A[i][j] = ((A[i][j] + mulq(u1[i], v1[j])) + mulq(u2[i], v2[j]))
        endfor
    endfor
    for u32 j in 0..16 do
        u64 s = 0
        for u32 i in 0..16 do
            s = (s + mulq(mulq(beta, y[i]), A[i][j]))
        endfor
        x[j] = ((x[j] + s) + z[j])
    endfor
    for u32 i in 0..16 do
        u64 s = 0
        for u32 j in 0..16 do
            s = (s + mulq(mulq(alpha, A[i][j]), x[j]))
        endfor
        w[i] = (w[i] + s)
    endfor
    return Result {v0: A, v1: w, v2: x}
