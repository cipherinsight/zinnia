from "../native_v1" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64[50] a, private u64[50] b, private u64[50] c) -> u64[50]:
    u64[50] result = [0;50]
    for u32 i in 0..50 do
        result[i] = divc(((a[i] + b[i]) + c[i]), 3)
    endfor
    return result
