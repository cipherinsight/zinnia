from "../native_field" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private field[15][15][10] utens_stage, private field[15][15][10] u_stage, private field[16][15][10] wcon, private field[15][15][10] u_pos, private field[15][15][10] utens, private field dtr_stage) -> field[15][15][10]:
    field[15][15][10] ccol = [[[0; 10]; 15]; 15]
    field[15][15][10] dcol = [[[0; 10]; 15]; 15]
    field[15][15] data_col = [[0; 15]; 15]
    for u32 i in 0..15 do
        for u32 j in 0..15 do
            field gcv = divc(wcon[i+1u32][j][1]+wcon[i][j][1],4)
            field cs = divc(gcv,2)
            ccol[i][j][0] = divc(gcv,2)
            field bcol = dtr_stage-ccol[i][j][0]
            field correction = 0-mulq(cs,u_stage[i][j][1]-u_stage[i][j][0])
            dcol[i][j][0] = mulq(dtr_stage,u_pos[i][j][0])+utens[i][j][0]+utens_stage[i][j][0]+correction
            field divided = divq(4294967296,bcol)
            ccol[i][j][0] = mulq(ccol[i][j][0],divided)
            dcol[i][j][0] = mulq(dcol[i][j][0],divided)
        endfor
    endfor
    for u32 k in 1..9 do
        for u32 i in 0..15 do
            for u32 j in 0..15 do
                field gav = 0-divc(wcon[i+1u32][j][k]+wcon[i][j][k],4)
                field gcv = divc(wcon[i+1u32][j][k+1u32]+wcon[i][j][k+1u32],4)
                field a_s = divc(gav,2)
                field cs = divc(gcv,2)
                field acol = divc(gav,2)
                ccol[i][j][k] = divc(gcv,2)
                field bcol = dtr_stage-acol-ccol[i][j][k]
                field correction = 0-mulq(a_s,u_stage[i][j][k-1u32]-u_stage[i][j][k])-mulq(cs,u_stage[i][j][k+1u32]-u_stage[i][j][k])
                dcol[i][j][k] = mulq(dtr_stage,u_pos[i][j][k])+utens[i][j][k]+utens_stage[i][j][k]+correction
                field divided = divq(4294967296,bcol-mulq(ccol[i][j][k-1u32],acol))
                ccol[i][j][k] = mulq(ccol[i][j][k],divided)
                dcol[i][j][k] = mulq(dcol[i][j][k]-mulq(dcol[i][j][k-1u32],acol),divided)
            endfor
        endfor
    endfor
    for u32 i in 0..15 do
        for u32 j in 0..15 do
            field gav = 0-divc(wcon[i+1u32][j][9]+wcon[i][j][9],4)
            field a_s = divc(gav,2)
            field acol = divc(gav,2)
            field bcol = dtr_stage-acol
            field correction = 0-mulq(a_s,u_stage[i][j][8]-u_stage[i][j][9])
            dcol[i][j][9] = mulq(dtr_stage,u_pos[i][j][9])+utens[i][j][9]+utens_stage[i][j][9]+correction
            field divided = divq(4294967296,bcol-mulq(ccol[i][j][8],acol))
            dcol[i][j][9] = mulq(dcol[i][j][9]-mulq(dcol[i][j][8],acol),divided)
            data_col[i][j] = dcol[i][j][9]
            utens_stage[i][j][9] = mulq(dtr_stage,data_col[i][j]-u_pos[i][j][9])
        endfor
    endfor
    for u32 reverse in 0..9 do
        u32 k = 8u32-reverse
        for u32 i in 0..15 do
            for u32 j in 0..15 do
                data_col[i][j] = dcol[i][j][k]-mulq(ccol[i][j][k],data_col[i][j])
                utens_stage[i][j][k] = mulq(dtr_stage,data_col[i][j]-u_pos[i][j][k])
            endfor
        endfor
    endfor
    return utens_stage
