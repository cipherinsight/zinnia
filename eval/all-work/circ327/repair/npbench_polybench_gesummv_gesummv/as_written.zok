from "../native" import neg, absv, ab, lt, divc, mulq, mul, divq, ui, it, integer_to_field

def main(private u64 alpha, private u64 beta, private u64[16][16] A, private u64[16][16] B, private u64[16] x) -> u64[16]:
    u64[16] result = [0;16]
    for u32 i in 0..16 do
        u64 left = 0
        u64 right = 0
        for u32 j in 0..16 do
            left = (left + mul(mul(alpha, A[i][j]), x[j]))
            right = (right + mul(mul(beta, B[i][j]), x[j]))
        endfor
        result[i] = (left + right)
    endfor
    return result
